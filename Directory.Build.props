<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Declared for every project so lock files are identical for plain restores and win-x64 publishes. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Version>0.9.0</Version>
    <Company>QIK</Company>
    <Product>QIK Suite</Product>
    <Description>QIK Suite: billing, inventory, accounting, CRM and service management for Indian businesses.</Description>
  </PropertyGroup>
</Project>
