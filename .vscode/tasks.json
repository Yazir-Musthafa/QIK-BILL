{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Nexora: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "Nexora.sln", "--configuration", "Debug"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Nexora: test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "tests/Nexora.Tests/Nexora.Tests.csproj", "--configuration", "Debug"],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
