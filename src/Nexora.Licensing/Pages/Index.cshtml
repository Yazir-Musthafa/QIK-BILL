@page
@model IndexModel
@{ ViewData["Title"] = "Customer accounts"; }
<div class="heading"><div><p class="eyebrow">ACCESS CONTROL</p><h1>Customer accounts</h1><p class="muted">Review registrations and manage access after receiving payment.</p></div><span class="badge">@Model.Accounts.Count accounts shown</span></div>
<div class="notice">A successful check gives 30 days of offline access. Suspension blocks the next check; previously issued access can remain valid for up to 30 days.</div>
@if (Model.Notice is not null) { <p class="notice" role="status">@Model.Notice</p> }
<form method="get" class="search"><label for="Search">Find a customer</label><input asp-for="Search" placeholder="Business, username or contact" maxlength="160" /><button>Search</button><a asp-page="/Index">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th>Customer</th><th>Username</th><th>Status</th><th>Registered</th><th>Last online check</th><th></th></tr></thead><tbody>
@foreach (var account in Model.Accounts) {
<tr><td><strong>@account.CustomerName</strong><small>@account.Contact</small></td><td>@account.Username</td><td><span class="badge">@account.Status</span></td><td>@account.CreatedUtc.ToString("dd MMM yyyy")</td><td>@(account.LastCheckedUtc?.ToString("dd MMM yyyy HH:mm 'UTC'") ?? "Not yet")</td><td><a asp-page="/Index" asp-route-Selected="@account.Id" asp-route-Search="@Model.Search">Manage</a></td></tr>
}
@if (Model.Accounts.Count == 0) { <tr><td colspan="6" class="empty">No matching accounts. New desktop registrations will appear here.</td></tr> }
</tbody></table></div><p class="muted">Newest 500 accounts shown. Use search to find older accounts.</p>
@if (Model.SelectedAccount is { } selected) {
<section class="panel"><h2>@selected.CustomerName</h2><p>@selected.Username · @selected.Status</p><p class="muted">Installation: @(selected.InstallationId?.ToString() ?? "Ready to bind at next sign-in")</p>
<form method="post" class="stack"><input type="hidden" asp-for="Selected" /><input type="hidden" asp-for="Search" />
<div asp-validation-summary="All" class="error" role="alert"></div>
<label asp-for="Action">Action</label><select asp-for="Action"><option value="Activate">Activate / reactivate account</option><option value="Suspend">Suspend account</option><option value="ResetInstallation">Reset installation for a computer move</option></select>
<label asp-for="Note">Reason / payment reference</label><textarea asp-for="Note" maxlength="500" required placeholder="For example: payment received, reference 1234"></textarea>
<p class="muted">Resetting allows the account to bind to a new installation. The old installation’s offline grant still lasts until its original expiry.</p><button class="primary" type="submit">Apply change</button></form>
<h2>Account history</h2><ul class="history">@foreach (var entry in Model.History) { <li><strong>@entry.Action</strong> · @entry.AtUtc.ToString("dd MMM yyyy HH:mm 'UTC'") · @entry.Actor<p>@entry.Note</p></li> }</ul></section>
}
