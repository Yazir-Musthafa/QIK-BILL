<Application x:Class="Nexora.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nexora.Desktop.Controls"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Index 0 is the theme token dictionary; ThemeService replaces it at runtime. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Nexora;component/Themes/Light.xaml" />
        <ResourceDictionary Source="/Nexora;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="/Nexora;component/Themes/Controls.xaml" />
        <ResourceDictionary Source="/Nexora;component/Views/ViewTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <controls:VisibleWhenConverter x:Key="VisibleWhen" />
      <controls:HasTextConverter x:Key="HasText" />
      <controls:InverseBoolConverter x:Key="Inverse" />
      <controls:AllTrueToVisibilityConverter x:Key="AllTrue" />
      <controls:DepthIndentConverter x:Key="DepthIndent" />
      <controls:IsNullConverter x:Key="IsNull" />
      <controls:IndianAmountConverter x:Key="Amount" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
