<!--
  Type scale and geometry tokens. FontSize and CornerRadius literals belong here only
  (enforced by DesignRuleTests). Hierarchy comes from weight and spacing, not colour.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <sys:Double x:Key="FontSizeTable">12</sys:Double>
  <sys:Double x:Key="FontSizeBody">13</sys:Double>
  <sys:Double x:Key="FontSizeSection">15</sys:Double>
  <sys:Double x:Key="FontSizeTitle">20</sys:Double>
  <sys:Double x:Key="IconSizeSmall">12</sys:Double>
  <sys:Double x:Key="IconSize">16</sys:Double>

  <CornerRadius x:Key="ControlRadius">4</CornerRadius>
  <CornerRadius x:Key="PanelRadius">6</CornerRadius>
  <sys:Double x:Key="ControlHeight">28</sys:Double>
  <sys:Double x:Key="RowHeight">30</sys:Double>

  <Style x:Key="Text.Title" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style x:Key="Text.Section" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTable}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTable}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="Text.Error" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTable}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <!-- Amounts: tabular figures so columns align; callers right-align -->
  <Style x:Key="Text.Amount" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTable}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style x:Key="Text.Kpi" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <Style x:Key="Text.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="{StaticResource IconSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
