<!--
  Dark theme tokens. Designed separately rather than inverted: surfaces step up in lightness,
  borders stay visible, the accent is a lighter teal tint and semantic colours are desaturated.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BackgroundColor">#16171A</Color>
  <Color x:Key="SurfaceColor">#1E2024</Color>
  <Color x:Key="SurfaceSubtleColor">#1A1C1F</Color>
  <Color x:Key="HoverColor">#272A30</Color>
  <Color x:Key="PressedColor">#2E3138</Color>
  <Color x:Key="BorderColor">#2D3036</Color>
  <Color x:Key="BorderStrongColor">#3C4048</Color>
  <Color x:Key="TextColor">#E8E9EB</Color>
  <Color x:Key="TextSecondaryColor">#9A9DA3</Color>
  <Color x:Key="TextDisabledColor">#5E626A</Color>

  <Color x:Key="AccentColor">#5FAEB1</Color>
  <Color x:Key="AccentHoverColor">#72BABD</Color>
  <Color x:Key="AccentPressedColor">#4F9EA1</Color>
  <Color x:Key="OnAccentColor">#0E1517</Color>
  <Color x:Key="AccentSubtleColor">#1F3335</Color>

  <Color x:Key="SuccessColor">#7DB699</Color>
  <Color x:Key="WarningColor">#D2A55E</Color>
  <Color x:Key="DangerColor">#E08C86</Color>
  <Color x:Key="OnDangerColor">#1A0F0E</Color>
  <Color x:Key="SuccessSubtleColor">#1E2E26</Color>
  <Color x:Key="WarningSubtleColor">#33291A</Color>
  <Color x:Key="DangerSubtleColor">#372221</Color>

  <Color x:Key="ScrimColor">#8C000000</Color>
  <Color x:Key="SkeletonColor">#272A30</Color>
  <Color x:Key="ChartNeutralColor">#4B4F58</Color>
  <Color x:Key="ShadowColor">#000000</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="OnDangerBrush" Color="{StaticResource OnDangerColor}" />
  <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}" />
  <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}" />
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtleColor}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
  <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource SkeletonColor}" />
  <SolidColorBrush x:Key="ChartNeutralBrush" Color="{StaticResource ChartNeutralColor}" />

  <DropShadowEffect x:Key="PopupShadow" Color="{StaticResource ShadowColor}" Opacity="0.4" BlurRadius="16" ShadowDepth="4" Direction="270" />
</ResourceDictionary>
