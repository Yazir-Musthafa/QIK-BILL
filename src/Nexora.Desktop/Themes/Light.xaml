<!--
  Light theme tokens. Dark.xaml must define exactly the same keys (enforced by DesignRuleTests).
  Views never use colours directly; they reference the *Brush keys through DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Neutrals: warm grey surfaces, near-black text, hairline borders -->
  <Color x:Key="BackgroundColor">#F6F5F2</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="SurfaceSubtleColor">#FAF9F7</Color>
  <Color x:Key="HoverColor">#F0EEEA</Color>
  <Color x:Key="PressedColor">#E8E6E0</Color>
  <Color x:Key="BorderColor">#E3E1DB</Color>
  <Color x:Key="BorderStrongColor">#CFCCC4</Color>
  <Color x:Key="TextColor">#1C1D1F</Color>
  <Color x:Key="TextSecondaryColor">#6B6E73</Color>
  <Color x:Key="TextDisabledColor">#A3A5A9</Color>

  <!-- The single accent: primary actions, selection and focus only -->
  <Color x:Key="AccentColor">#0F5F63</Color>
  <Color x:Key="AccentHoverColor">#0C5256</Color>
  <Color x:Key="AccentPressedColor">#0A4548</Color>
  <Color x:Key="OnAccentColor">#FFFFFF</Color>
  <Color x:Key="AccentSubtleColor">#E3EEEE</Color>

  <!-- Muted semantic colours: status text, small badges, meaningful chart series -->
  <Color x:Key="SuccessColor">#2E6A4F</Color>
  <Color x:Key="WarningColor">#87591A</Color>
  <Color x:Key="DangerColor">#A13A35</Color>
  <Color x:Key="OnDangerColor">#FFFFFF</Color>
  <Color x:Key="SuccessSubtleColor">#E7F0EA</Color>
  <Color x:Key="WarningSubtleColor">#F5EEE2</Color>
  <Color x:Key="DangerSubtleColor">#F6E6E4</Color>

  <!-- Utility -->
  <Color x:Key="ScrimColor">#521C1D1F</Color>
  <Color x:Key="SkeletonColor">#ECEAE5</Color>
  <Color x:Key="ChartNeutralColor">#BDBAB2</Color>
  <Color x:Key="ShadowColor">#000000</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="OnDangerBrush" Color="{StaticResource OnDangerColor}" />
  <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}" />
  <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}" />
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtleColor}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
  <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource SkeletonColor}" />
  <SolidColorBrush x:Key="ChartNeutralBrush" Color="{StaticResource ChartNeutralColor}" />

  <!-- The one shadow level, for popups and dialogs only -->
  <DropShadowEffect x:Key="PopupShadow" Color="{StaticResource ShadowColor}" Opacity="0.12" BlurRadius="16" ShadowDepth="4" Direction="270" />
</ResourceDictionary>
