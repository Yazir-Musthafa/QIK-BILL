<UserControl x:Class="Nexora.Desktop.Views.Accounting.OpeningBalancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="24,20,24,24" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Secondary}" Margin="0,0,0,16" TextWrapping="Wrap"
               Text="Enter balances brought forward from your previous books for assets, liabilities and capital. They are posted as one opening voucher dated 1 April of the chosen year." />
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <StackPanel Width="160">
        <TextBlock Text="Financial year" Style="{StaticResource Text.Label}" />
        <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" DisplayMemberPath="Label" AutomationProperties.Name="Financial year" />
      </StackPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Error}" Margin="0,0,0,8" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
      <Button Content="Post opening balances" Style="{StaticResource Button.Primary}" Command="{Binding PostCommand}" HorizontalAlignment="Left" />
    </StackPanel>
    <Border Style="{StaticResource Panel}" Padding="12">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="140" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Account" Style="{StaticResource Text.Label}" />
          <TextBlock Grid.Column="1" Text="Debit" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" Margin="0,0,8,4" />
          <TextBlock Grid.Column="2" Text="Credit" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" Margin="0,0,8,4" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Account.Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBox Grid.Column="1" Text="{Binding Debit, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="0,0,8,0"
                           Typography.NumeralAlignment="Tabular" AutomationProperties.Name="{Binding Account.Name, StringFormat={}{0} debit}" />
                  <TextBox Grid.Column="2" Text="{Binding Credit, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="0,0,8,0"
                           Typography.NumeralAlignment="Tabular" AutomationProperties.Name="{Binding Account.Name, StringFormat={}{0} credit}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
