<UserControl x:Class="Nexora.Desktop.Views.Accounting.ChartOfAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="24,20,24,24">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Style="{StaticResource Text.Error}" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />

    <Border DockPanel.Dock="Right" Width="320" Margin="16,0,0,0" Style="{StaticResource Panel}" VerticalAlignment="Top" IsEnabled="{Binding CanEdit}">
      <StackPanel>
        <TextBlock Text="Edit account" Style="{StaticResource Text.Section}" Margin="0,0,0,12"
                   Visibility="{Binding IsExisting, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Text="New account" Style="{StaticResource Text.Section}" Margin="0,0,0,12"
                   Visibility="{Binding IsExisting, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
        <TextBlock Text="Group" Style="{StaticResource Text.Label}" />
        <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Parent}" DisplayMemberPath="Display" MaxDropDownHeight="360"
                  IsTextSearchEnabled="True" TextSearch.TextPath="Name" AutomationProperties.Name="Parent group" />
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Code" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" CharacterCasing="Upper" AutomationProperties.Name="Account code" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Type" Style="{StaticResource Text.Label}" />
            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" AutomationProperties.Name="Account type" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Name" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Account name" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Nature (asset, liability, equity, income, expense) comes from the group. Choose Group as the type to create a group." />
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button Content="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
          <Button Content="New" Command="{Binding NewCommand}" Margin="0,0,8,0" />
          <Button Command="{Binding ToggleActiveCommand}" Visibility="{Binding IsExisting, Converter={StaticResource VisibleWhen}}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Content" Value="Deactivate" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Selected.IsActive}" Value="False"><Setter Property="Content" Value="Reactivate" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}" SelectionMode="Single" CanUserSortColumns="False"
              AutomationProperties.Name="Chart of accounts">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80" />
        <DataGridTemplateColumn Header="Account" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <!-- Indent by depth: 16px per level -->
                <Border Width="{Binding Depth, Converter={StaticResource DepthIndent}}" />
                <TextBlock x:Name="Name" Text="{Binding Name}" VerticalAlignment="Center" />
                <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="4,0"
                        Visibility="{Binding SystemKey, Converter={StaticResource VisibleWhen}}">
                  <TextBlock Text="System" />
                </Border>
                <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="4,0"
                        Visibility="{Binding IsActive, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                  <TextBlock Text="Inactive" />
                </Border>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                  <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Nature" Binding="{Binding Nature}" Width="90" />
        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
