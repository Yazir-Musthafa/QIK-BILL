<UserControl x:Class="Nexora.Desktop.Views.Accounting.StatementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <DataTemplate x:Key="StatementLine">
      <DockPanel Margin="0,0,0,4">
        <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeTable}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,20,24,24">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <StackPanel Width="110" Margin="0,0,12,0">
          <TextBlock Text="From" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="From date (dd-mm-yyyy)" />
        </StackPanel>
        <StackPanel Width="110" Margin="0,0,12,0">
          <TextBlock Text="To" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="To date (dd-mm-yyyy)" />
        </StackPanel>
        <Button Content="Show" Style="{StaticResource Button.Primary}" Command="{Binding ShowCommand}" VerticalAlignment="Bottom" IsDefault="True" />
      </StackPanel>
      <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Error}" Margin="0,0,0,8" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
      <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,12" TextWrapping="Wrap"
                 Text="Profit and loss covers From to To. The balance sheet is as of To. Earlier years' profit is shown in Retained Earnings." />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="16" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Profit and loss" Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
            <TextBlock Text="Income" Style="{StaticResource Text.Label}" />
            <ItemsControl ItemsSource="{Binding ProfitAndLoss.Income}" ItemTemplate="{StaticResource StatementLine}" Focusable="False" />
            <DockPanel Margin="0,4,0,12">
              <TextBlock DockPanel.Dock="Right" Text="{Binding ProfitAndLoss.TotalIncome, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" FontWeight="SemiBold" />
              <TextBlock Text="Total income" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTable}" />
            </DockPanel>
            <TextBlock Text="Expenses" Style="{StaticResource Text.Label}" />
            <ItemsControl ItemsSource="{Binding ProfitAndLoss.Expenses}" ItemTemplate="{StaticResource StatementLine}" Focusable="False" />
            <DockPanel Margin="0,4,0,12">
              <TextBlock DockPanel.Dock="Right" Text="{Binding ProfitAndLoss.TotalExpenses, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" FontWeight="SemiBold" />
              <TextBlock Text="Total expenses" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTable}" />
            </DockPanel>
            <Separator />
            <DockPanel Margin="0,8,0,0">
              <TextBlock DockPanel.Dock="Right" Text="{Binding NetProfit}" Style="{StaticResource Text.Amount}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSection}" />
              <TextBlock Text="Net profit (loss shown negative)" Style="{StaticResource Text.Section}" />
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Danger}"
                      Visibility="{Binding BalanceSheet.IsBalanced, Converter={StaticResource VisibleWhen}, ConverterParameter=invert, FallbackValue=Collapsed}">
                <TextBlock Text="Does not balance" />
              </Border>
              <TextBlock Text="Balance sheet" Style="{StaticResource Text.Section}" />
            </DockPanel>
            <TextBlock Text="Assets" Style="{StaticResource Text.Label}" />
            <ItemsControl ItemsSource="{Binding BalanceSheet.Assets}" ItemTemplate="{StaticResource StatementLine}" Focusable="False" />
            <DockPanel Margin="0,4,0,12">
              <TextBlock DockPanel.Dock="Right" Text="{Binding AssetsTotal}" Style="{StaticResource Text.Amount}" FontWeight="SemiBold" />
              <TextBlock Text="Total assets" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTable}" />
            </DockPanel>
            <TextBlock Text="Liabilities" Style="{StaticResource Text.Label}" />
            <ItemsControl ItemsSource="{Binding BalanceSheet.Liabilities}" ItemTemplate="{StaticResource StatementLine}" Focusable="False" />
            <TextBlock Text="Equity" Style="{StaticResource Text.Label}" Margin="0,8,0,4" />
            <ItemsControl ItemsSource="{Binding BalanceSheet.Equity}" ItemTemplate="{StaticResource StatementLine}" Focusable="False" />
            <DockPanel Margin="0,0,0,4">
              <TextBlock DockPanel.Dock="Right" Text="{Binding BalanceSheet.CurrentYearProfit, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
              <TextBlock Text="Profit for the current year" FontSize="{StaticResource FontSizeTable}" />
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
              <TextBlock DockPanel.Dock="Right" Text="{Binding LiabilitiesTotal}" Style="{StaticResource Text.Amount}" FontWeight="SemiBold" />
              <TextBlock Text="Total liabilities and equity" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTable}" />
            </DockPanel>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
