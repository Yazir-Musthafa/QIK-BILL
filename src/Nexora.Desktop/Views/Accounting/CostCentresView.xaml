<UserControl x:Class="Nexora.Desktop.Views.Accounting.CostCentresView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Nexora.Desktop.Controls">
  <DockPanel Margin="24,20,24,24" IsEnabled="{Binding IsBusy, Converter={StaticResource Inverse}}">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Style="{StaticResource Text.Error}" />
    <StackPanel DockPanel.Dock="Bottom" IsEnabled="{Binding CanEdit}" Margin="0,16,0,0">
      <WrapPanel>
        <StackPanel Width="120" Margin="0,0,8,8"><TextBlock Text="Code" Style="{StaticResource Text.Label}" /><TextBox Text="{Binding Code}" /></StackPanel>
        <StackPanel Width="240" Margin="0,0,8,8"><TextBlock Text="Name" Style="{StaticResource Text.Label}" /><TextBox Text="{Binding Name}" /></StackPanel>
        <StackPanel Width="140" Margin="0,0,8,8"><TextBlock Text="Kind" Style="{StaticResource Text.Label}" /><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" /></StackPanel>
      </WrapPanel>
      <WrapPanel><Button Content="New" Command="{Binding NewCommand}" Margin="0,0,8,0" /><Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0" /><Button Content="Activate / deactivate" Command="{Binding ToggleActiveCommand}" /></WrapPanel>
      <TextBlock Text="Tag income and expense lines in Vouchers. Deactivating a centre keeps its history." Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
    </StackPanel>
    <controls:QikDataGrid LayoutKey="cost-centres" ItemsSource="{Binding Centres}" SelectedItem="{Binding Selected}" SelectionMode="Single">
      <controls:QikDataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120" /><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="120" /><DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="80" /></controls:QikDataGrid.Columns>
    </controls:QikDataGrid>
  </DockPanel>
</UserControl>
