<!-- View-model-first navigation: each view model type maps to one view. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexora.Desktop.ViewModels"
                    xmlns:views="clr-namespace:Nexora.Desktop.Views"
                    xmlns:svm="clr-namespace:Nexora.Desktop.ViewModels.Settings"
                    xmlns:sviews="clr-namespace:Nexora.Desktop.Views.Settings"
                    xmlns:avm="clr-namespace:Nexora.Desktop.ViewModels.Accounting"
                    xmlns:aviews="clr-namespace:Nexora.Desktop.Views.Accounting"
                    xmlns:ivm="clr-namespace:Nexora.Desktop.ViewModels.Inventory"
                    xmlns:iviews="clr-namespace:Nexora.Desktop.Views.Inventory"
                    xmlns:bvm="clr-namespace:Nexora.Desktop.ViewModels.Billing"
                    xmlns:bviews="clr-namespace:Nexora.Desktop.Views.Billing">
  <DataTemplate DataType="{x:Type vm:SetupWizardViewModel}"><views:SetupWizardView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:ShellViewModel}"><views:ShellView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderView /></DataTemplate>
  <DataTemplate DataType="{x:Type svm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
  <DataTemplate DataType="{x:Type svm:GeneralSettingsViewModel}"><sviews:GeneralSettingsView /></DataTemplate>
  <DataTemplate DataType="{x:Type svm:CompanyProfileViewModel}"><sviews:CompanyProfileView /></DataTemplate>
  <DataTemplate DataType="{x:Type svm:LocationsViewModel}"><sviews:LocationsView /></DataTemplate>
  <DataTemplate DataType="{x:Type svm:NumberingViewModel}"><sviews:NumberingView /></DataTemplate>
  <DataTemplate DataType="{x:Type svm:UsersViewModel}"><sviews:UsersView /></DataTemplate>
  <DataTemplate DataType="{x:Type svm:RolesViewModel}"><sviews:RolesView /></DataTemplate>
  <DataTemplate DataType="{x:Type svm:AuditViewModel}"><sviews:AuditView /></DataTemplate>
  <DataTemplate DataType="{x:Type svm:ChangePasswordViewModel}"><sviews:ChangePasswordView /></DataTemplate>
  <DataTemplate DataType="{x:Type avm:ChartOfAccountsViewModel}"><aviews:ChartOfAccountsView /></DataTemplate>
  <DataTemplate DataType="{x:Type avm:VouchersViewModel}"><aviews:VouchersView /></DataTemplate>
  <DataTemplate DataType="{x:Type avm:LedgerViewModel}"><aviews:LedgerView /></DataTemplate>
  <DataTemplate DataType="{x:Type avm:TrialBalanceViewModel}"><aviews:TrialBalanceView /></DataTemplate>
  <DataTemplate DataType="{x:Type avm:StatementsViewModel}"><aviews:StatementsView /></DataTemplate>
  <DataTemplate DataType="{x:Type avm:OpeningBalancesViewModel}"><aviews:OpeningBalancesView /></DataTemplate>
  <DataTemplate DataType="{x:Type avm:FinancialYearsViewModel}"><aviews:FinancialYearsView /></DataTemplate>
  <DataTemplate DataType="{x:Type ivm:ProductsViewModel}"><iviews:ProductsView /></DataTemplate>
  <DataTemplate DataType="{x:Type ivm:StockViewModel}"><iviews:StockView /></DataTemplate>
  <DataTemplate DataType="{x:Type ivm:InventorySettingsViewModel}"><iviews:InventorySettingsView /></DataTemplate>
  <!-- Sales and purchases share one view each; WPF matches the template on the base view model. -->
  <DataTemplate DataType="{x:Type bvm:BillingViewModel}"><bviews:BillingView /></DataTemplate>
  <DataTemplate DataType="{x:Type bvm:PartiesViewModel}"><bviews:PartiesView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:HelpViewModel}"><views:HelpView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:GalleryViewModel}"><views:GalleryView /></DataTemplate>
</ResourceDictionary>
