<UserControl x:Class="Nexora.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- Panel header: section title on the left, optional caption on the right -->
    <Style x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="EmptyText" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
      <Setter Property="Margin" Value="0,4,0,8" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="24,20,24,24">
      <!-- Header -->
      <DockPanel>
        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding QuickActions}" VerticalAlignment="Center" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Margin="8,0,0,0" Padding="10,0" AutomationProperties.Name="{Binding Label}"
                      Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding TargetKey}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Text.Icon}" FontSize="{StaticResource IconSizeSmall}" Text="{Binding Glyph}"
                             Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>

      <!-- Error state -->
      <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xEA39;" Foreground="{DynamicResource DangerBrush}"
                     VerticalAlignment="Top" Margin="0,1,12,0" />
          <Button DockPanel.Dock="Right" Content="Retry" Command="{Binding LoadCommand}" VerticalAlignment="Top" />
          <StackPanel>
            <TextBlock Text="Dashboard unavailable" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Secondary}" Margin="0,2,12,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Loading skeleton -->
      <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}">
        <UniformGrid Columns="4" Rows="2">
          <StackPanel Margin="0,0,24,16"><Border Style="{StaticResource Skeleton}" Width="80" /><Border Style="{StaticResource Skeleton}" Width="140" Height="20" Margin="0,8,0,0" /></StackPanel>
          <StackPanel Margin="0,0,24,16"><Border Style="{StaticResource Skeleton}" Width="80" /><Border Style="{StaticResource Skeleton}" Width="140" Height="20" Margin="0,8,0,0" /></StackPanel>
          <StackPanel Margin="0,0,24,16"><Border Style="{StaticResource Skeleton}" Width="80" /><Border Style="{StaticResource Skeleton}" Width="140" Height="20" Margin="0,8,0,0" /></StackPanel>
          <StackPanel Margin="0,0,24,16"><Border Style="{StaticResource Skeleton}" Width="80" /><Border Style="{StaticResource Skeleton}" Width="140" Height="20" Margin="0,8,0,0" /></StackPanel>
          <StackPanel Margin="0,0,24,0"><Border Style="{StaticResource Skeleton}" Width="80" /><Border Style="{StaticResource Skeleton}" Width="140" Height="20" Margin="0,8,0,0" /></StackPanel>
          <StackPanel Margin="0,0,24,0"><Border Style="{StaticResource Skeleton}" Width="80" /><Border Style="{StaticResource Skeleton}" Width="140" Height="20" Margin="0,8,0,0" /></StackPanel>
          <StackPanel Margin="0,0,24,0"><Border Style="{StaticResource Skeleton}" Width="80" /><Border Style="{StaticResource Skeleton}" Width="140" Height="20" Margin="0,8,0,0" /></StackPanel>
          <StackPanel Margin="0,0,24,0"><Border Style="{StaticResource Skeleton}" Width="80" /><Border Style="{StaticResource Skeleton}" Width="140" Height="20" Margin="0,8,0,0" /></StackPanel>
        </UniformGrid>
      </Border>

      <StackPanel>
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsLoading}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Error, Converter={StaticResource HasText}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>

        <!-- Notice: demonstration label or honest empty state -->
        <Border Margin="0,16,0,0" Padding="12,8" CornerRadius="{StaticResource PanelRadius}" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSubtleBrush}">
          <DockPanel>
            <Border DockPanel.Dock="Left" Style="{StaticResource Badge.Warning}" Margin="0,0,10,0"
                    Visibility="{Binding IsDemonstration, Converter={StaticResource VisibleWhen}}">
              <TextBlock Text="Demonstration data" />
            </Border>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" FontSize="{StaticResource IconSizeSmall}" Text="&#xE946;"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"
                       Visibility="{Binding IsDemonstration, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
            <TextBlock Text="{Binding Notice}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <!-- KPI figures: one bordered panel, hairline dividers, no coloured tiles -->
        <Border Style="{StaticResource Panel}" Padding="0" Margin="0,16,0,0" ClipToBounds="True">
          <ItemsControl ItemsSource="{Binding Kpis}" Margin="0,0,-1,-1" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1" Padding="16,12">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Kpi}" Margin="0,4,0,2" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- Charts row -->
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                  <Border Width="8" Height="8" Background="{DynamicResource AccentBrush}" CornerRadius="{StaticResource ControlRadius}" />
                  <TextBlock Text="Revenue" Style="{StaticResource Text.Caption}" Margin="6,0,12,0" />
                  <Border Width="8" Height="8" Background="{DynamicResource ChartNeutralBrush}" CornerRadius="{StaticResource ControlRadius}" />
                  <TextBlock Text="Expenses" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="Revenue vs expenses" Style="{StaticResource PanelTitle}" />
              </DockPanel>

              <ItemsControl ItemsSource="{Binding Trend}" Height="180" Focusable="False"
                            Visibility="{Binding Trend.Count, Converter={StaticResource VisibleWhen}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ToolTip="{Binding Tooltip}" Background="Transparent">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="20" />
                      </Grid.RowDefinitions>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="14" Margin="0,0,3,0" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1"
                                CornerRadius="{StaticResource ControlRadius}" Height="158" VerticalAlignment="Bottom">
                          <Border.RenderTransform>
                            <ScaleTransform ScaleY="{Binding Revenue}" />
                          </Border.RenderTransform>
                        </Border>
                        <Border Width="14" Background="{DynamicResource ChartNeutralBrush}" RenderTransformOrigin="0.5,1"
                                CornerRadius="{StaticResource ControlRadius}" Height="158" VerticalAlignment="Bottom">
                          <Border.RenderTransform>
                            <ScaleTransform ScaleY="{Binding Expenses}" />
                          </Border.RenderTransform>
                        </Border>
                      </StackPanel>
                      <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
                      <TextBlock Grid.Row="2" Text="{Binding Label}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Visibility="{Binding Trend.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" Height="180">
                <TextBlock Style="{StaticResource EmptyText}" Text="Monthly revenue and expenses appear once invoices and expenses are posted." />
                <Button Content="Open sales invoices" Style="{StaticResource Button.Link}" HorizontalAlignment="Left"
                        Command="{Binding OpenCommand}" CommandParameter="sales.invoices" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="Receivables ageing" Style="{StaticResource PanelTitle}" />
              <ItemsControl ItemsSource="{Binding Ageing}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,12">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" Style="{StaticResource Text.Amount}" />
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" />
                      </DockPanel>
                      <Grid Height="4" Margin="0,4,0,0">
                        <Border Background="{DynamicResource HoverBrush}" CornerRadius="{StaticResource ControlRadius}" />
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="{StaticResource ControlRadius}" RenderTransformOrigin="0,0.5">
                          <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Fraction}" />
                          </Border.RenderTransform>
                        </Border>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Visibility="{Binding Ageing.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource EmptyText}" Text="No outstanding customer invoices." />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <!-- My follow-ups (real data from CRM, for users who can see CRM) -->
        <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Visibility="{Binding ShowFollowUps, Converter={StaticResource VisibleWhen}}">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Open CRM" Style="{StaticResource Button.Link}" Command="{Binding OpenCommand}" CommandParameter="crm" />
              <TextBlock Text="My follow-ups" Style="{StaticResource PanelTitle}" />
            </DockPanel>
            <TextBlock Text="{Binding FollowUpSummary}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding FollowUps}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,6">
                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Danger}" Visibility="{Binding IsOverdue, Converter={StaticResource VisibleWhen}}"><TextBlock Text="Overdue" /></Border>
                    <TextBlock Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding DueDate, StringFormat=dd-MM-yyyy, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Regarding, Mode=OneWay}" />
                    </TextBlock>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Lists row -->
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="Top products" Style="{StaticResource PanelTitle}" />
              <ItemsControl ItemsSource="{Binding TopProducts}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" Style="{StaticResource Text.Amount}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeTable}" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <Grid Height="3" Margin="0,4,0,0">
                        <Border Background="{DynamicResource ChartNeutralBrush}" RenderTransformOrigin="0,0.5" CornerRadius="{StaticResource ControlRadius}">
                          <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Fraction}" />
                          </Border.RenderTransform>
                        </Border>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Visibility="{Binding TopProducts.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource EmptyText}" Text="Best-selling products are listed here after the first sales." />
                <Button Content="Add a product" Style="{StaticResource Button.Link}" HorizontalAlignment="Left"
                        Command="{Binding OpenCommand}" CommandParameter="inventory.products" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="Low stock" Style="{StaticResource PanelTitle}" />
              <DataGrid ItemsSource="{Binding LowStock}" HeadersVisibility="Column" MaxHeight="220"
                        Visibility="{Binding LowStock.Count, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Low stock">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="80"
                                      HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
                  <DataGridTextColumn Header="Reorder" Binding="{Binding ReorderLevel}" Width="70"
                                      HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel Visibility="{Binding LowStock.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource EmptyText}" Text="Items below their reorder level appear here." />
                <Button Content="Open stock" Style="{StaticResource Button.Link}" HorizontalAlignment="Left"
                        Command="{Binding OpenCommand}" CommandParameter="inventory.stock" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="4" Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="Recent activity" Style="{StaticResource PanelTitle}" />
              <ItemsControl ItemsSource="{Binding Activity}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,10">
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Style="{StaticResource Text.Caption}" Width="44"
                                 Typography.NumeralAlignment="Tabular" />
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeTable}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Visibility="{Binding Activity.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource EmptyText}" Text="Invoices, receipts and stock changes will be listed here as they happen." />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
