<UserControl x:Class="Nexora.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nexora.Desktop.Controls">
  <Grid Margin="16">
    <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="QIK Suite" Style="{StaticResource Text.Section}" Foreground="{DynamicResource AccentBrush}" />
      <TextBlock Text="Sign in" Style="{StaticResource Text.Title}" Margin="0,16,0,24" />

      <Border Style="{StaticResource Panel}" Padding="24">
        <StackPanel>
          <TextBlock Text="Username" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="32"
                   controls:Behaviors.FocusOnVisible="True" AutomationProperties.Name="Username" />

          <TextBlock Text="Password" Style="{StaticResource Text.Label}" Margin="0,16,0,4" />
          <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" MaxLength="128"
                       controls:FieldAssist.HasError="{Binding Error, Converter={StaticResource HasText}}"
                       AutomationProperties.Name="Password" />

          <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Error}" Margin="0,8,0,0"
                     Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}"
                     AutomationProperties.LiveSetting="Assertive" />

          <Button Content="Sign in" Style="{StaticResource Button.Primary}" IsDefault="True" Margin="0,20,0,0"
                  HorizontalAlignment="Stretch" Command="{Binding SignInCommand}" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                 Text="Forgot your password? Ask your administrator to reset it." />
    </StackPanel>
  </Grid>
</UserControl>
