<UserControl x:Class="Nexora.Desktop.Views.Inventory.InventorySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nexora.Desktop.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,24">
      <TextBlock Text="Costing and stock policy" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
      <Border Style="{StaticResource Panel}" IsEnabled="{Binding CanChangePolicy}">
        <StackPanel>
          <TextBlock Text="Costing method" Style="{StaticResource Text.Label}" />
          <RadioButton Content="Weighted average: issues at the running average cost" GroupName="Costing" Margin="0,4,0,0"
                       IsChecked="{Binding IsFifo, Converter={StaticResource Inverse}, Mode=TwoWay}" />
          <RadioButton Content="FIFO: issues the oldest stock's cost first" GroupName="Costing" Margin="0,4,0,0" IsChecked="{Binding IsFifo, Mode=TwoWay}" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="The costing method is fixed once any stock has moved, because it decides every stored value. Cost is pooled per product across all warehouses." />
          <Border Style="{StaticResource Badge.Warning}" Margin="0,8,0,0" Visibility="{Binding HasMovements, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Stock has moved: the costing method is now fixed" />
          </Border>
          <CheckBox Content="Allow negative stock (weighted average only)" IsChecked="{Binding AllowNegativeStock}" Margin="0,16,0,0" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="24,4,0,0" TextWrapping="Wrap"
                     Text="Off by default. When on, issues may take stock below zero; batches and serial numbers can never go negative." />
          <Button Content="Save policy" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
        </StackPanel>
      </Border>
      <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="Changing the policy needs both Inventory: Manage and Company: Manage."
                 Visibility="{Binding CanChangePolicy, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />

      <TextBlock Text="Units" Style="{StaticResource Text.Section}" Margin="0,24,0,8" />
      <controls:QikDataGrid LayoutKey="inventory-units" ItemsSource="{Binding Units}" MaxHeight="280" AutomationProperties.Name="Units">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Decimals" Binding="{Binding DecimalPlaces}" Width="90" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
        </DataGrid.Columns>
      </controls:QikDataGrid>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding CanEdit}">
        <TextBox Text="{Binding UnitCode, UpdateSourceTrigger=PropertyChanged}" Width="80" MaxLength="10" CharacterCasing="Upper" Margin="0,0,8,0" AutomationProperties.Name="New unit code" />
        <TextBox Text="{Binding UnitName, UpdateSourceTrigger=PropertyChanged}" Width="200" MaxLength="40" Margin="0,0,8,0" AutomationProperties.Name="New unit name" />
        <TextBox Text="{Binding UnitDecimals, UpdateSourceTrigger=PropertyChanged}" Width="50" MaxLength="1" TextAlignment="Right" Margin="0,0,8,0" AutomationProperties.Name="New unit decimal places" />
        <Button Content="Add unit" Command="{Binding AddUnitCommand}" />
      </StackPanel>

      <TextBlock Text="Tax categories" Style="{StaticResource Text.Section}" Margin="0,24,0,8" />
      <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,8" TextWrapping="Wrap"
                 Text="Reference rates only. Sales and purchases with GST (Phase 5) will use dated rates, so posted documents keep the rate that applied. Check current GST rates before relying on these." />
      <controls:QikDataGrid LayoutKey="inventory-tax" ItemsSource="{Binding TaxCategories}" MaxHeight="240" AutomationProperties.Name="Tax categories">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Reference rate %" Binding="{Binding ReferenceRatePercent}" Width="130" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
        </DataGrid.Columns>
      </controls:QikDataGrid>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding CanEdit}">
        <TextBox Text="{Binding TaxName, UpdateSourceTrigger=PropertyChanged}" Width="200" MaxLength="60" Margin="0,0,8,0" AutomationProperties.Name="New tax category name" />
        <TextBox Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}" Width="70" TextAlignment="Right" Margin="0,0,8,0" AutomationProperties.Name="Reference rate percent" />
        <Button Content="Add tax category" Command="{Binding AddTaxCategoryCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Error}" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
