<UserControl x:Class="Nexora.Desktop.Views.Reporting.ReportsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Nexora.Desktop.Controls">
  <UserControl.Resources>
    <CollectionViewSource x:Key="ReportsSource" Source="{Binding Catalogue}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group" /></CollectionViewSource.GroupDescriptions></CollectionViewSource>
  </UserControl.Resources>
  <Grid Margin="24,20,24,24" IsEnabled="{Binding IsBusy, Converter={StaticResource Inverse}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,12" />
      <ListBox ItemsSource="{Binding Source={StaticResource ReportsSource}}" SelectedItem="{Binding SelectedReport}" DisplayMemberPath="Title" AutomationProperties.Name="Reports by group">
        <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}" Margin="0,12,0,4" /></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
      </ListBox>
    </DockPanel>
    <DockPanel Grid.Column="2">
      <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedReport.Title}" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
      <WrapPanel DockPanel.Dock="Top"><StackPanel Width="120" Margin="0,0,8,8" Visibility="{Binding HasRange, Converter={StaticResource VisibleWhen}}"><TextBlock Text="From" Style="{StaticResource Text.Label}" /><TextBox Text="{Binding From}" /></StackPanel><StackPanel Width="120" Margin="0,0,8,8" Visibility="{Binding HasRange, Converter={StaticResource VisibleWhen}}"><TextBlock Text="To" Style="{StaticResource Text.Label}" /><TextBox Text="{Binding To}" /></StackPanel><StackPanel Width="120" Margin="0,0,8,8" Visibility="{Binding HasAsOf, Converter={StaticResource VisibleWhen}}"><TextBlock Text="As of" Style="{StaticResource Text.Label}" /><TextBox Text="{Binding AsOf}" /></StackPanel><StackPanel Width="110" Margin="0,0,8,8" Visibility="{Binding HasPeriod, Converter={StaticResource VisibleWhen}}"><TextBlock Text="Period" Style="{StaticResource Text.Label}" /><ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" /></StackPanel><StackPanel Width="200" Margin="0,0,8,8" Visibility="{Binding HasParty, Converter={StaticResource VisibleWhen}}"><TextBlock Text="Party" Style="{StaticResource Text.Label}" /><ComboBox ItemsSource="{Binding PartyChoices}" SelectedItem="{Binding Party}" DisplayMemberPath="Name" /></StackPanel><StackPanel Width="200" Margin="0,0,8,8" Visibility="{Binding HasProduct, Converter={StaticResource VisibleWhen}}"><TextBlock Text="Product" Style="{StaticResource Text.Label}" /><ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding Product}" DisplayMemberPath="Name" /></StackPanel><StackPanel Width="180" Margin="0,0,8,8" Visibility="{Binding HasWarehouse, Converter={StaticResource VisibleWhen}}"><TextBlock Text="Warehouse" Style="{StaticResource Text.Label}" /><ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name" /></StackPanel><StackPanel Width="230" Margin="0,0,8,8" Visibility="{Binding HasAccount, Converter={StaticResource VisibleWhen}}"><TextBlock Text="Account / bank" Style="{StaticResource Text.Label}" /><ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" DisplayMemberPath="Name" /></StackPanel><StackPanel Width="150" Margin="0,0,8,8" Visibility="{Binding HasGrouping, Converter={StaticResource VisibleWhen}}"><TextBlock Text="Group expenses by" Style="{StaticResource Text.Label}" /><ComboBox ItemsSource="{Binding Groupings}" SelectedItem="{Binding Grouping}" /></StackPanel></WrapPanel>
      <WrapPanel DockPanel.Dock="Top">
        <StackPanel Width="190" Margin="0,0,8,8" IsEnabled="{Binding CanSearch}"><TextBlock Text="Search report" Style="{StaticResource Text.Label}" /><TextBox Text="{Binding Search}" /></StackPanel>
        <StackPanel Width="140" Margin="0,0,8,8"><TextBlock Text="Sort column" Style="{StaticResource Text.Label}" /><ComboBox ItemsSource="{Binding SortColumns}" SelectedItem="{Binding SortColumn}" DisplayMemberPath="Header" /></StackPanel>
        <CheckBox Content="Descending" IsChecked="{Binding Descending}" VerticalAlignment="Bottom" Margin="0,0,8,12" />
        <StackPanel Width="80" Margin="0,0,8,8"><TextBlock Text="Page size" Style="{StaticResource Text.Label}" /><ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" /></StackPanel>
        <Button Content="Run" Command="{Binding RunReportCommand}" Style="{StaticResource Button.Primary}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
      </WrapPanel>
      <WrapPanel DockPanel.Dock="Top" IsEnabled="{Binding HasResult}" Margin="0,0,0,8" ToolTip="Output uses the last completed Run, including all matching pages.">
        <Button Content="CSV" Command="{Binding ExportCommand}" CommandParameter="Csv" IsEnabled="{Binding CanExport}" Margin="0,0,8,0" />
        <Button Content="Excel" Command="{Binding ExportCommand}" CommandParameter="Excel" IsEnabled="{Binding CanExport}" Margin="0,0,8,0" />
        <Button Content="PDF" Command="{Binding ExportCommand}" CommandParameter="Pdf" IsEnabled="{Binding CanExport}" Margin="0,0,8,0" />
        <Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,0,8,0" /><Button Content="Print" Command="{Binding PrintCommand}" Margin="0,0,8,0" />
        <Button Content="Open source" Command="{Binding OpenSourceCommand}" />
      </WrapPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Style="{StaticResource Text.Error}" />
      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <TextBlock Text="{Binding TotalsText}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Notes}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,8" />
        <WrapPanel><Button Content="Previous" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" Margin="0,0,8,0" /><Button Content="Next" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" Margin="0,0,12,0" /><TextBlock Text="{Binding PageText}" VerticalAlignment="Center" TextWrapping="Wrap" /></WrapPanel>
      </StackPanel>
      <controls:QikDataGrid x:Name="ReportTable" ShowFilter="False" ItemsSource="{Binding Result.Rows}" SelectedItem="{Binding SelectedRow}" SelectionMode="Single" CanUserSortColumns="False" AutomationProperties.Name="Report results" />
    </DockPanel>
  </Grid>
</UserControl>
