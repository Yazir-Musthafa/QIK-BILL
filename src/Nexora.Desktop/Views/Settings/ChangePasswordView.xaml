<UserControl x:Class="Nexora.Desktop.Views.Settings.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nexora.Desktop.Controls">
  <Grid Margin="16">
    <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />
      <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,16" TextWrapping="Wrap"
                 Text="Your administrator set a temporary password. Choose your own before continuing."
                 Visibility="{Binding IsForced, Converter={StaticResource VisibleWhen}}" />
      <Border Style="{StaticResource Panel}" Padding="24">
        <StackPanel>
          <TextBlock Text="Current password" Style="{StaticResource Text.Label}" />
          <PasswordBox x:Name="CurrentInput" PasswordChanged="OnChanged" MaxLength="128" controls:Behaviors.FocusOnVisible="True"
                       AutomationProperties.Name="Current password" />
          <TextBlock Text="New password" Style="{StaticResource Text.Label}" Margin="0,16,0,4" />
          <PasswordBox x:Name="NewInput" PasswordChanged="OnChanged" MaxLength="128" AutomationProperties.Name="New password" />
          <TextBlock Text="Confirm new password" Style="{StaticResource Text.Label}" Margin="0,16,0,4" />
          <PasswordBox x:Name="ConfirmInput" PasswordChanged="OnChanged" MaxLength="128" AutomationProperties.Name="Confirm new password" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="At least 10 characters, and not containing your username." />
          <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Error}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"
                     Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
          <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Sign out" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsForced, Converter={StaticResource VisibleWhen}}" />
            <Button DockPanel.Dock="Right" Content="Change password" Style="{StaticResource Button.Primary}" IsDefault="True" Command="{Binding SaveCommand}" />
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
