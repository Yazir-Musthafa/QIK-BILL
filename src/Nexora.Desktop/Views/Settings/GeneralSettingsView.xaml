<UserControl x:Class="Nexora.Desktop.Views.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,24">
      <TextBlock Text="Appearance" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
      <Border Style="{StaticResource Panel}">
        <StackPanel>
          <TextBlock Text="Theme" Style="{StaticResource Text.Label}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <RadioButton Content="Light" GroupName="Theme" Margin="0,0,24,0"
                         IsChecked="{Binding IsDarkTheme, Converter={StaticResource Inverse}, Mode=TwoWay}" />
            <RadioButton Content="Dark" GroupName="Theme" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
          </StackPanel>
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Text="Also available with Ctrl+Shift+L." />
        </StackPanel>
      </Border>

      <TextBlock Text="Your companies" Style="{StaticResource Text.Section}" Margin="0,24,0,8" />
      <Border Style="{StaticResource Panel}" Padding="0">
        <ItemsControl ItemsSource="{Binding Companies}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0" MinHeight="44">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Delete" VerticalAlignment="Center"
                          Command="{Binding DataContext.DeleteDemoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" AutomationProperties.Name="Delete demonstration company">
                    <Button.Visibility>
                      <MultiBinding Converter="{StaticResource AllTrue}">
                        <Binding Path="IsDemo" />
                        <Binding Path="DataContext.CanDeleteDemo" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                      </MultiBinding>
                    </Button.Visibility>
                  </Button>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding RoleName}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,16,0" />
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Badge.Warning}" Margin="8,0,0,0" Visibility="{Binding IsDemo, Converter={StaticResource VisibleWhen}}">
                      <TextBlock Text="Demonstration" />
                    </Border>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <StackPanel Visibility="{Binding CanCreateCompany, Converter={StaticResource VisibleWhen}}">
        <TextBlock Text="Create a company" Style="{StaticResource Text.Section}" Margin="0,24,0,8" />
        <Border Style="{StaticResource Panel}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Company name" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding NewCompanyName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="New company name" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="State" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding NewCompanyState}" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                          MaxDropDownHeight="320" AutomationProperties.Name="New company state" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="First financial year" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding FinancialYears}" SelectedItem="{Binding NewCompanyYear}" DisplayMemberPath="Label"
                          AutomationProperties.Name="New company first financial year" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="You become the new company's administrator. It starts with the built-in roles, numbering and a standard chart of accounts." />
            <Button Content="Create company" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,12,0,0"
                    Command="{Binding CreateCompanyCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Error}" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
