<UserControl x:Class="Nexora.Desktop.Views.Settings.BackupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Nexora.Desktop.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" IsEnabled="{Binding IsBusy, Converter={StaticResource Inverse}}">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,12" />
      <TextBlock Text="Backups contain every company and user on this computer. Creating or restoring one requires Backup: Manage in every company." TextWrapping="Wrap" />
      <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,8,0,12" />
      <TextBlock Text="Manual backup folder" Style="{StaticResource Text.Label}" />
      <DockPanel><Button DockPanel.Dock="Right" Content="Choose…" Command="{Binding ChooseFolderCommand}" Margin="8,0,0,0" /><TextBox Text="{Binding Folder}" /></DockPanel>
      <TextBlock Text="Password (optional for creation; required to open encrypted backups)" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
      <PasswordBox PasswordChanged="OnPasswordChanged" MaxLength="256" AutomationProperties.Name="Backup password" />
      <TextBlock Text="Use at least 10 characters and keep the password safely. There is no password recovery. The header still shows company names and creation time." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,8" />
      <Button Content="Create backup" Command="{Binding CreateCommand}" HorizontalAlignment="Left" Style="{StaticResource Button.Primary}" />
      <TextBlock Text="Backup to verify or restore" Style="{StaticResource Text.Label}" Margin="0,16,0,4" />
      <DockPanel><Button DockPanel.Dock="Right" Content="Choose file…" Command="{Binding ChooseFileCommand}" Margin="8,0,0,0" /><TextBox Text="{Binding BackupFile}" /></DockPanel>
      <WrapPanel Margin="0,8,0,8"><Button Content="Verify" Command="{Binding VerifyCommand}" Margin="0,0,8,0" /><Button Content="Restore all companies…" Command="{Binding RestoreCommand}" /></WrapPanel>
      <TextBlock Text="{Binding Verification}" TextWrapping="Wrap" />
      <TextBlock Text="Automatic backups" Style="{StaticResource Text.Section}" Margin="0,20,0,8" />
      <CheckBox Content="Enable automatic backups while QIK Suite is open" IsChecked="{Binding Automatic}" />
      <TextBlock Text="Checked on startup and every 15 minutes. Automatic and safety backups are unencrypted; choose a folder protected by your Windows account or an encrypted drive." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,8" />
      <WrapPanel><StackPanel Width="140" Margin="0,0,8,8"><TextBlock Text="Every (hours)" Style="{StaticResource Text.Label}" /><TextBox Text="{Binding IntervalHours}" /></StackPanel><StackPanel Width="140" Margin="0,0,8,8"><TextBlock Text="Automatic files to keep" Style="{StaticResource Text.Label}" /><TextBox Text="{Binding KeepCount}" /></StackPanel></WrapPanel>
      <TextBlock Text="Automatic folder (blank uses the default)" Style="{StaticResource Text.Label}" />
      <DockPanel><Button DockPanel.Dock="Right" Content="Choose…" Command="{Binding ChooseAutomaticFolderCommand}" Margin="8,0,0,0" /><TextBox Text="{Binding AutomaticFolder}" /></DockPanel>
      <WrapPanel Margin="0,8,0,8"><Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,0" /><Button Content="Check schedule now" Command="{Binding CheckScheduleCommand}" /></WrapPanel>
      <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Error}" />
      <TextBlock Text="History (latest 50 attempts)" Style="{StaticResource Text.Section}" Margin="0,16,0,8" />
      <controls:QikDataGrid LayoutKey="backup-history" ItemsSource="{Binding History}" Height="250">
        <controls:QikDataGrid.Columns><DataGridTextColumn Header="Time (UTC)" Binding="{Binding Utc, StringFormat=dd-MM-yyyy HH:mm}" Width="140" /><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90" /><DataGridTextColumn Header="Succeeded" Binding="{Binding Succeeded}" Width="85" /><DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="220" /><DataGridTextColumn Header="Result" Binding="{Binding Message}" Width="300" /></controls:QikDataGrid.Columns>
      </controls:QikDataGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
