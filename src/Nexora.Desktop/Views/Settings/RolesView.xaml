<UserControl x:Class="Nexora.Desktop.Views.Settings.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="0,0,0,24">
    <TextBlock DockPanel.Dock="Top" Text="Roles and permissions" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Style="{StaticResource Text.Error}" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />

    <DockPanel DockPanel.Dock="Left" Width="240" Margin="0,0,16,0">
      <Button DockPanel.Dock="Bottom" Content="New role" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding NewCommand}"
              Visibility="{Binding CanEdit, Converter={StaticResource VisibleWhen}}" />
      <DataGrid ItemsSource="{Binding Roles}" SelectedItem="{Binding Selected}" SelectionMode="Single" AutomationProperties.Name="Roles">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Role" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Users" Binding="{Binding MemberCount}" Width="56" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <Border Style="{StaticResource Panel}" IsEnabled="{Binding CanEdit}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" IsReadOnly="{Binding IsSystem}" AutomationProperties.Name="Role name" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Discount limit (%)" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding MaxDiscountPercent, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"
                       IsReadOnly="{Binding IsAdministrator}" AutomationProperties.Name="Discount limit percent" />
            </StackPanel>
          </Grid>
          <TextBlock Text="Description" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
          <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Role description" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="The Administrator role always has every permission. You can only grant permissions you have yourself."
                     Visibility="{Binding IsAdministrator, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
          <Button Content="Save role" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
          <Button Content="Delete role" Command="{Binding DeleteCommand}"
                  Visibility="{Binding IsSystem, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Focusable="False" IsEnabled="{Binding IsAdministrator, Converter={StaticResource Inverse}}">
          <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,12">
                  <TextBlock Text="{Binding Module}" Style="{StaticResource Text.Label}" />
                  <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4,0,0" ToolTip="{Binding Info.Description}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Info.Action}" Width="140" />
                            <TextBlock Text="{Binding Info.Description}" Style="{StaticResource Text.Caption}" />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
