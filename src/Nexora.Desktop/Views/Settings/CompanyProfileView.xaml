<UserControl x:Class="Nexora.Desktop.Views.Settings.CompanyProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,24">
      <DockPanel Margin="0,0,0,8">
        <TextBlock DockPanel.Dock="Right" Text="{Binding FinancialYear, StringFormat=Books start in FY {0}}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
        <TextBlock Text="Company profile" Style="{StaticResource Text.Section}" />
      </DockPanel>
      <Border Style="{StaticResource Panel}">
        <Grid IsEnabled="{Binding CanEdit}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="16" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
            <TextBlock Text="Trade name" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Trade name" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
            <TextBlock Text="Legal name" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Legal name" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
            <TextBlock Text="Address line 1" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Address line 1" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
            <TextBlock Text="Address line 2" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Address line 2" />
          </StackPanel>
          <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="City" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="City" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="PIN code" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding Pincode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" AutomationProperties.Name="PIN code" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
            <TextBlock Text="State" Style="{StaticResource Text.Label}" />
            <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                      MaxDropDownHeight="320" AutomationProperties.Name="State" />
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
            <TextBlock Text="Phone" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" AutomationProperties.Name="Phone" />
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
            <TextBlock Text="Email" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Email" />
          </StackPanel>
          <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,12">
            <TextBlock Text="PAN" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Pan, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" CharacterCasing="Upper" AutomationProperties.Name="PAN" />
          </StackPanel>
          <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
            <TextBlock Text="GSTIN" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" CharacterCasing="Upper" AutomationProperties.Name="GSTIN" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Checked for format and check character only. QIK Suite does not verify it with the GST portal." />
          </StackPanel>
          <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal">
            <Button Content="Save profile" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
            <Button Content="Choose logo…" Click="OnChooseLogo" Margin="0,0,8,0" />
            <Button Content="Remove logo" Click="OnRemoveLogo" Visibility="{Binding HasLogo, Converter={StaticResource VisibleWhen}}" />
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Text="You can view this profile but not change it."
                 Visibility="{Binding CanEdit, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
      <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Error}" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
