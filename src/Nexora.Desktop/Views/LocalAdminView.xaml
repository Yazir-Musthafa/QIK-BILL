<UserControl x:Class="Nexora.Desktop.Views.LocalAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="900" Margin="24" HorizontalAlignment="Stretch">
      <DockPanel>
        <Button Content="Sign out of admin" Command="{Binding SignOutCommand}" DockPanel.Dock="Right" />
        <TextBlock Text="QIK Suite · Admin" Style="{StaticResource Text.Title}" />
      </DockPanel>
      <TextBlock Text="Manage activation on this computer. One activation covers this customer's installation and all its staff logins."
                 Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,20" />
      <Border Style="{StaticResource Panel}" Padding="20">
        <StackPanel>
          <TextBlock Text="Installation status" Style="{StaticResource Text.Label}" />
          <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Section}" Margin="0,4,0,12" />
          <TextBlock Text="Registered accounts" Style="{StaticResource Text.Label}" />
          <ItemsControl ItemsSource="{Binding Customers}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="{Binding Username}" Margin="0,0,16,0" />
                <TextBlock Text="{Binding DisplayName}" />
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Reason (for example, payment received or payment pending)" Style="{StaticResource Text.Label}" Margin="0,16,0,4" />
          <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Activation change reason" />
          <WrapPanel Margin="0,16,0,0">
            <Button Content="Activate / Reactivate" Command="{Binding ActivateCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0" />
            <Button Content="Suspend installation" Command="{Binding SuspendCommand}" Margin="0,0,8,0" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
          </WrapPanel>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
      </Border>
      <TextBlock Text="Activation history" Style="{StaticResource Text.Section}" Margin="0,24,0,12" />
      <ItemsControl ItemsSource="{Binding History}">
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,8">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding AtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm} UTC}" Margin="0,0,16,0" />
                <TextBlock Text="{Binding Action}" Margin="0,0,16,0" />
                <TextBlock Text="{Binding Actor}" />
              </StackPanel>
              <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
