<UserControl x:Class="Nexora.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="24,20" MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
    <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Top"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelRadius}">
          <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
        <StackPanel>
          <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" />
          <TextBlock Text="{Binding Availability}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,16" />
          <Button Content="Back to dashboard" HorizontalAlignment="Left" Command="{Binding GoToDashboardCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </StackPanel>
</UserControl>
