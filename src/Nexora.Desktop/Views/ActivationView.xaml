<UserControl x:Class="Nexora.Desktop.Views.ActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Width="480" HorizontalAlignment="Center" Margin="24">
      <TextBlock Text="QIK Suite" Style="{StaticResource Text.Section}" Foreground="{DynamicResource AccentBrush}" />
      <TextBlock Text="Activate QIK Suite" Style="{StaticResource Text.Title}" Margin="0,12,0,8" />
      <TextBlock Text="One activation covers this installation and its staff logins. Once approved, you can work offline for 30 days. Internet is needed again when that period ends."
                 Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,16" />
      <Border Style="{StaticResource Panel}" Padding="20">
        <StackPanel>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Assertive" />
          <Button Content="Check activation" Command="{Binding CheckCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" />
          <TextBlock Text="Activation account" Style="{StaticResource Text.Section}" Margin="0,20,0,8" />
          <TextBlock Text="Username" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" AutomationProperties.Name="Activation username" />
          <TextBlock Text="Password" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
          <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" MaxLength="128" AutomationProperties.Name="Activation password" />
          <Button Content="Sign in to activation account" Command="{Binding SignInCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" />
          <TextBlock Text="New customer registration" Style="{StaticResource Text.Section}" Margin="0,20,0,8" />
          <TextBlock Text="Business / customer name" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Customer name" />
          <TextBlock Text="Phone or email for the admin to contact you" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
          <TextBox Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Contact details" />
          <TextBlock Text="Use at least 10 password characters, without your username. New accounts need the admin's approval before any company pages open."
                     Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
          <Button Content="Register and request activation" Command="{Binding RegisterCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <TextBlock Text="Installation code (share this with the admin)" Style="{StaticResource Text.Caption}" Margin="0,16,0,4" />
      <TextBox Text="{Binding InstallationCode, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Installation code" />
      <Button Content="Open online admin panel" Command="{Binding OpenAdminCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
