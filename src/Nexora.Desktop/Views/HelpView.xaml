<UserControl x:Class="Nexora.Desktop.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
      <TextBlock Text="Getting started" Style="{StaticResource Text.Section}" Margin="0,16,0,8" />
      <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
      <TextBlock Text="Step-by-step task guide" Style="{StaticResource Text.Section}" Margin="0,24,0,8" />
      <TextBlock Text="You can leave optional details blank. Hints explain what is needed when saving, posting or exporting. Expand a section to see every available field. Save your work before leaving a page." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
      <ItemsControl ItemsSource="{Binding Topics}">
        <ItemsControl.ItemTemplate><DataTemplate>
            <Expander Header="{Binding Title}" Margin="0,0,0,4"><TextBlock Text="{Binding Steps}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" /></Expander>
          </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Keyboard shortcuts" Style="{StaticResource Text.Section}" Margin="0,24,0,8" />
      <DataGrid ItemsSource="{Binding Shortcuts}" AutomationProperties.Name="Keyboard shortcuts" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Keys" Binding="{Binding Keys}" Width="160" FontWeight="SemiBold" />
          <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>

    </StackPanel></ScrollViewer>
</UserControl>
