<UserControl x:Class="Nexora.Desktop.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nexora.Desktop.Controls"
             xmlns:vm="clr-namespace:Nexora.Desktop.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <Grid Margin="16,48">
      <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Nexora" Style="{StaticResource Text.Section}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="Set up your workspace" Style="{StaticResource Text.Title}" Margin="0,16,0,4" />
        <TextBlock Style="{StaticResource Text.Secondary}"
                   Text="Create your company and the administrator account. You can add more companies and users later." />

        <!-- Step indicator: three labelled segments; the current one carries the accent -->
        <Grid Margin="0,24,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <Border Height="2" Background="{DynamicResource AccentBrush}" />
            <TextBlock Text="1  Company" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,8,0">
            <Border Height="2">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompanyStep}" Value="False">
                      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>
            <TextBlock Text="2  Administrator" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Border Height="2">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReviewStep}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>
            <TextBlock Text="3  Review" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
          </StackPanel>
        </Grid>

        <Border Style="{StaticResource Panel}" Padding="24">
          <StackPanel>
            <TextBlock Text="{Binding StepCaption}" Style="{StaticResource Text.Caption}" />

            <!-- Step 1: company -->
            <StackPanel Visibility="{Binding IsCompanyStep, Converter={StaticResource VisibleWhen}}" controls:Behaviors.AnimateIn="True">
              <TextBlock Text="Company" Style="{StaticResource Text.Section}" Margin="0,4,0,16" />

              <TextBlock Text="Company name" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"
                       controls:Behaviors.FocusOnVisible="{Binding IsCompanyStep}"
                       controls:FieldAssist.HasError="{Binding CompanyNameError, Converter={StaticResource HasText}}"
                       AutomationProperties.Name="Company name" />
              <TextBlock Text="{Binding CompanyNameError}" Style="{StaticResource Text.Error}"
                         Visibility="{Binding CompanyNameError, Converter={StaticResource VisibleWhen}}" />

              <TextBlock Text="State (place of business)" Style="{StaticResource Text.Label}" Margin="0,16,0,4" />
              <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" IsTextSearchEnabled="True"
                        TextSearch.TextPath="Name" MaxDropDownHeight="320"
                        controls:FieldAssist.HasError="{Binding StateError, Converter={StaticResource HasText}}"
                        AutomationProperties.Name="State" />
              <TextBlock Text="{Binding StateError}" Style="{StaticResource Text.Error}"
                         Visibility="{Binding StateError, Converter={StaticResource VisibleWhen}}" />
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="Used to decide intra-state or inter-state GST once sales are enabled." />

              <TextBlock Text="First financial year" Style="{StaticResource Text.Label}" Margin="0,16,0,4" />
              <ComboBox ItemsSource="{Binding FinancialYears}" SelectedItem="{Binding SelectedFinancialYear}"
                        DisplayMemberPath="Label" Width="160" HorizontalAlignment="Left"
                        controls:FieldAssist.HasError="{Binding FinancialYearError, Converter={StaticResource HasText}}"
                        AutomationProperties.Name="First financial year" />
              <TextBlock Text="{Binding FinancialYearError}" Style="{StaticResource Text.Error}"
                         Visibility="{Binding FinancialYearError, Converter={StaticResource VisibleWhen}}" />
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="1 April to 31 March." />
            </StackPanel>

            <!-- Step 2: administrator -->
            <StackPanel Visibility="{Binding IsAdministratorStep, Converter={StaticResource VisibleWhen}}" controls:Behaviors.AnimateIn="True">
              <TextBlock Text="Administrator" Style="{StaticResource Text.Section}" Margin="0,4,0,16" />

              <TextBlock Text="Full name" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"
                       controls:Behaviors.FocusOnVisible="{Binding IsAdministratorStep}"
                       controls:FieldAssist.HasError="{Binding DisplayNameError, Converter={StaticResource HasText}}"
                       AutomationProperties.Name="Full name" />
              <TextBlock Text="{Binding DisplayNameError}" Style="{StaticResource Text.Error}"
                         Visibility="{Binding DisplayNameError, Converter={StaticResource VisibleWhen}}" />

              <TextBlock Text="Username" Style="{StaticResource Text.Label}" Margin="0,16,0,4" />
              <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="32"
                       controls:FieldAssist.HasError="{Binding UsernameError, Converter={StaticResource HasText}}"
                       AutomationProperties.Name="Username" />
              <TextBlock Text="{Binding UsernameError}" Style="{StaticResource Text.Error}"
                         Visibility="{Binding UsernameError, Converter={StaticResource VisibleWhen}}" />

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Password" Style="{StaticResource Text.Label}" />
                  <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" MaxLength="128"
                               controls:FieldAssist.HasError="{Binding PasswordError, Converter={StaticResource HasText}}"
                               AutomationProperties.Name="Password" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Confirm password" Style="{StaticResource Text.Label}" />
                  <PasswordBox x:Name="ConfirmationInput" PasswordChanged="OnConfirmationChanged" MaxLength="128"
                               controls:FieldAssist.HasError="{Binding ConfirmationError, Converter={StaticResource HasText}}"
                               AutomationProperties.Name="Confirm password" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding PasswordError}" Style="{StaticResource Text.Error}"
                         Visibility="{Binding PasswordError, Converter={StaticResource VisibleWhen}}" />
              <TextBlock Text="{Binding ConfirmationError}" Style="{StaticResource Text.Error}"
                         Visibility="{Binding ConfirmationError, Converter={StaticResource VisibleWhen}}" />
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="At least 10 characters. A short phrase is easier to remember than random symbols." />
            </StackPanel>

            <!-- Step 3: review -->
            <StackPanel Visibility="{Binding IsReviewStep, Converter={StaticResource VisibleWhen}}" controls:Behaviors.AnimateIn="True">
              <TextBlock Text="Review" Style="{StaticResource Text.Section}" Margin="0,4,0,16" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="28" />
                  <RowDefinition Height="28" />
                  <RowDefinition Height="28" />
                  <RowDefinition Height="28" />
                  <RowDefinition Height="28" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Company" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CompanyName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Text="State" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReviewState}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Text="First financial year" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedFinancialYear.Label}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="3" Text="Administrator" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="4" Text="Username" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Username}" VerticalAlignment="Center" />
              </Grid>
              <Separator Margin="0,16" />
              <CheckBox IsChecked="{Binding CreateDemoCompany}" Content="Also create a demonstration company with sample data"
                        controls:Behaviors.FocusOnVisible="{Binding IsReviewStep}" />
              <TextBlock Style="{StaticResource Text.Caption}" Margin="24,4,0,0" TextWrapping="Wrap"
                         Text="Kept separate from your company, clearly labelled, and can be deleted from Settings." />
            </StackPanel>

            <TextBlock Text="{Binding FormError}" Style="{StaticResource Text.Error}" Margin="0,16,0,0"
                       Visibility="{Binding FormError, Converter={StaticResource VisibleWhen}}" />

            <DockPanel Margin="0,24,0,0" LastChildFill="False">
              <Button DockPanel.Dock="Left" Content="Back" Command="{Binding BackCommand}"
                      Visibility="{Binding CanGoBack, Converter={StaticResource VisibleWhen}}" />
              <Button DockPanel.Dock="Right" Content="Create workspace" Style="{StaticResource Button.Primary}" IsDefault="True"
                      Command="{Binding FinishCommand}" Visibility="{Binding IsReviewStep, Converter={StaticResource VisibleWhen}}" />
              <Button DockPanel.Dock="Right" Content="Next" Style="{StaticResource Button.Primary}" IsDefault="True"
                      Command="{Binding NextCommand}" Visibility="{Binding IsReviewStep, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
              <TextBlock DockPanel.Dock="Right" Text="Creating…" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
