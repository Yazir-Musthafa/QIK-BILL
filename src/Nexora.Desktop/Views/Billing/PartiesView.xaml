<UserControl x:Class="Nexora.Desktop.Views.Billing.PartiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nexora.Desktop.Controls">
  <Grid Margin="24,20,24,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="400" />
    </Grid.ColumnDefinitions>

    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
        <Button DockPanel.Dock="Right" Content="{Binding NewLabel}" Style="{StaticResource Button.Primary}" Command="{Binding NewCommand}"
                Visibility="{Binding CanEdit, Converter={StaticResource VisibleWhen}}" />
        <CheckBox DockPanel.Dock="Right" Content="Show inactive" IsChecked="{Binding ShowInactive}" VerticalAlignment="Center" Margin="0,0,16,0" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
      </DockPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Style="{StaticResource Text.Error}" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
      <controls:QikDataGrid LayoutKey="parties" ItemsSource="{Binding Parties}" SelectedItem="{Binding Selected}" SelectionMode="Single"
                            AutomationProperties.Name="{Binding Title}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="160" />
          <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110" />
          <DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin}" Width="140" />
          <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120" />
          <DataGridTextColumn Header="City" Binding="{Binding City}" Width="100" />
          <DataGridTextColumn Header="Outstanding" Binding="{Binding Outstanding, Converter={StaticResource Amount}}" SortMemberPath="Outstanding" Width="110"
                              controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
          <DataGridTextColumn Header="Unapplied" Binding="{Binding Unapplied, Converter={StaticResource Amount}, ConverterParameter=blank}" SortMemberPath="Unapplied" Width="100"
                              controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
          <DataGridTextColumn Header="Ledger balance" Binding="{Binding LedgerBalance, Converter={StaticResource Amount}}" SortMemberPath="LedgerBalance" Width="120"
                              controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
          <DataGridTextColumn Header="Credit limit" Binding="{Binding CreditLimit, Converter={StaticResource Amount}, ConverterParameter=blank}" SortMemberPath="CreditLimit" Width="100"
                              HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
          <DataGridTemplateColumn Header="Status" Width="90" SortMemberPath="IsActive">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Badge}" Visibility="{Binding IsActive, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"><TextBlock Text="Inactive" /></Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </controls:QikDataGrid>
    </DockPanel>

    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
        <Border Style="{StaticResource Panel}" IsEnabled="{Binding CanEdit}">
          <StackPanel>
            <TextBlock Text="{Binding EditorHeading}" Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
            <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Name" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Phone" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" AutomationProperties.Name="Phone" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Email" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Email" />
              </StackPanel>
            </Grid>
            <TextBlock Text="GSTIN (blank if unregistered)" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" CharacterCasing="Upper" AutomationProperties.Name="GSTIN" />
            <TextBlock Text="State (place of supply; taken from the GSTIN when given)" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" DisplayMemberPath="Display" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                      MaxDropDownHeight="360" AutomationProperties.Name="State" />
            <TextBlock Text="Address" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Address" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="City" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="City" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Pincode" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Pincode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" AutomationProperties.Name="Pincode" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Credit limit" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding CreditLimit, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Credit limit" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="A ledger account is created for the party under Sundry Debtors or Sundry Creditors. The credit limit is shown, not enforced." />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
              <Button Content="Deactivate or reactivate" Command="{Binding ToggleActiveCommand}"
                      Visibility="{Binding IsNew, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Visibility="{Binding IsNew, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
          <StackPanel>
            <TextBlock Text="Statement of account" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="From" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding StatementFrom, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Statement from (dd-mm-yyyy)" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="To" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding StatementTo, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Statement to (dd-mm-yyyy)" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Preview" Command="{Binding PreviewStatementCommand}" Margin="0,0,8,0" />
              <Button Content="Print" Command="{Binding PrintStatementCommand}" Margin="0,0,8,0" />
              <Button Content="Export PDF" Command="{Binding ExportStatementPdfCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Visibility="{Binding IsNew, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
          <StackPanel>
            <TextBlock Text="Documents and settlements" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding OpenItems}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Number}" Style="{StaticResource Text.Body}" />
                      <TextBlock Style="{StaticResource Text.Caption}">
                        <Run Text="{Binding Type, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Date, StringFormat=dd-MM-yyyy, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Amount, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
                    <TextBlock Grid.Column="2" Text="{Binding Open, Converter={StaticResource Amount}, ConverterParameter=blank}" Style="{StaticResource Text.Amount}"
                               ToolTip="Still open" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Second column: amount. Third column: what is still open (blank when settled)." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
