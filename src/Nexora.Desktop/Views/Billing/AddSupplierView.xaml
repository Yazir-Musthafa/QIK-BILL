<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Nexora.Desktop.Views.Billing.AddSupplierView">
  <DockPanel Margin="24,20,24,24">
    <TextBlock DockPanel.Dock="Top" Text="Add Supplier" Style="{StaticResource Text.Title}" />
    <TextBlock DockPanel.Dock="Top" Text="Save your supplier once. You can then choose them on every purchase." Style="{StaticResource Text.Secondary}" Margin="0,8,0,16" />
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Style="{StaticResource Text.Error}" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="700" HorizontalAlignment="Left">
        <Border Style="{StaticResource Panel}" IsEnabled="{Binding CanEdit}">
          <StackPanel>
            <TextBlock Text="{Binding EditorHeading}" Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
            <TextBlock Text="{Binding NumberLabel}" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Number, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Supplier or customer number" Margin="0,0,0,12" />
            <TextBlock Text="Supplier name" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Supplier name" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Mobile / phone" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" AutomationProperties.Name="Phone" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Email" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Email" />
              </StackPanel>
            </Grid>
            <TextBlock Text="GSTIN (blank if unregistered)" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" CharacterCasing="Upper" AutomationProperties.Name="GSTIN" />
            <TextBlock Text="State (place of supply; taken from the GSTIN when given)" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" DisplayMemberPath="Display" IsTextSearchEnabled="True" TextSearch.TextPath="Name" MaxDropDownHeight="360" AutomationProperties.Name="State" />
            <TextBlock Text="Address" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Address" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="City" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="City" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Pincode" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Pincode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" AutomationProperties.Name="Pincode" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Credit limit" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding CreditLimit, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Credit limit" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" Text="Your accounts are created automatically. Save the name and contact details here, then choose it while billing." />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
              <Button Content="Deactivate or reactivate" Command="{Binding ToggleActiveCommand}" Visibility="{Binding IsNew, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <WrapPanel Margin="0,16,0,0">
          <Button Content="Add another supplier" Command="{Binding NewCommand}" Margin="0,0,8,8" />
          <Button Content="Go to Purchase" Command="{Binding OpenPurchaseCommand}" Margin="0,0,8,8" />
          <Button Content="View supplier accounts" Command="{Binding OpenSuppliersCommand}" Margin="0,0,8,8" />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
