<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:Nexora.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Nexora.Desktop.Views.Billing.BillingView">
  <DockPanel Margin="24,20,24,24">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource Button.Subtle}" Command="{Binding RefreshCommand}" />
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding WorkflowHint}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,12" />
    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Sections}" SelectedItem="{Binding Section}" DisplayMemberPath="Label" Margin="0,0,0,16" AutomationProperties.Name="Sections">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Style="{StaticResource Text.Error}" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
    <!-- Document preview: the stored document as calculated by the application (printing comes in Phase 6). -->
    <Border DockPanel.Dock="Right" Width="440" Margin="16,0,0,0" Style="{StaticResource Panel}" Visibility="{Binding ShowPreview, Converter={StaticResource VisibleWhen}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <WrapPanel Margin="0,0,0,4">
            <Button Content="Preview" Command="{Binding PreviewDocumentCommand}" Margin="0,0,8,8" />
            <Button Content="Print" Style="{StaticResource Button.Primary}" Command="{Binding PrintDocumentCommand}" Margin="0,0,8,8" />
            <Button Content="Export PDF" Command="{Binding ExportDocumentPdfCommand}" Margin="0,0,8,8" />
            <Button Content="Print on receipt printer" Command="{Binding PrintOnReceiptPrinterCommand}" Margin="0,0,8,8" Visibility="{Binding IsSales, Converter={StaticResource VisibleWhen}}" />
            <Button Content="Delivery note" Command="{Binding PreviewDeliveryNoteCommand}" Margin="0,0,8,8" Visibility="{Binding PreviewCanDeliveryNote, Converter={StaticResource VisibleWhen}}" />
            <Button Content="Purchase order" Command="{Binding PreviewPurchaseOrderCommand}" Margin="0,0,8,8" Visibility="{Binding PreviewCanPurchaseOrder, Converter={StaticResource VisibleWhen}}" />
          </WrapPanel>
          <Expander Header="Print item labels" Visibility="{Binding CanPrintPurchaseLabels, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,8">
            <StackPanel Margin="0,8,0,0">
              <ComboBox ItemsSource="{Binding LabelLayouts}" SelectedItem="{Binding LabelLayout}" DisplayMemberPath="Name" AutomationProperties.Name="Purchase label layout" />
              <TextBlock Text="Labels per item (0 skips). Uses current product name, barcode and prices." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,4" />
              <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PurchaseLabels}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,4">
                        <TextBox DockPanel.Dock="Right" Width="70" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Number of labels" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <WrapPanel Margin="0,8,0,0">
                <Button Content="Preview labels" Command="{Binding PreviewPurchaseLabelsCommand}" Margin="0,0,8,0" />
                <Button Content="Print labels" Command="{Binding PrintPurchaseLabelsCommand}" />
              </WrapPanel>
            </StackPanel>
          </Expander>
          <WrapPanel Visibility="{Binding PreviewIsDraft, Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding CanCreate}">
            <Button Content="Finish saving" Style="{StaticResource Button.Primary}" Command="{Binding PostSelectedCommand}" Margin="0,0,8,8" />
            <Button Content="Edit draft" Command="{Binding EditSelectedCommand}" Margin="0,0,8,8" />
            <Button Content="Delete draft" Style="{StaticResource Button.Danger}" Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,8" />
          </WrapPanel>
          <Button Content="Return items" HorizontalAlignment="Left" Command="{Binding ReturnSelectedCommand}" Margin="0,0,0,8" Visibility="{Binding PreviewCanReturn, Converter={StaticResource VisibleWhen}}" />
          <StackPanel Visibility="{Binding PreviewCanCancel, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Cancel: reason and date" Style="{StaticResource Text.Label}" />
            <DockPanel>
              <TextBox DockPanel.Dock="Right" Text="{Binding ActionDate, UpdateSourceTrigger=PropertyChanged}" Width="100" MaxLength="10" Margin="8,0,0,0" AutomationProperties.Name="Cancellation date (dd-mm-yyyy)" />
              <TextBox Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Reason for cancelling" />
            </DockPanel>
            <Button Content="Cancel document" Style="{StaticResource Button.Danger}" HorizontalAlignment="Left" Command="{Binding CancelSelectedCommand}" Margin="0,8,0,0" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel DataContext="{Binding Preview}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Danger}" Visibility="{Binding IsCancelled, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="Cancelled" />
              </Border>
              <TextBlock Style="{StaticResource Text.Section}">
                <Run Text="{Binding Number, Mode=OneWay, TargetNullValue=Draft}" />
              </TextBlock>
            </DockPanel>
            <TextBlock Style="{StaticResource Text.Caption}">
              <Run Text="{Binding Date, StringFormat=dd-MM-yyyy, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Mode, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding CompanyName}" Style="{StaticResource Text.Body}" Margin="0,12,0,0" />
            <TextBlock Style="{StaticResource Text.Caption}">
              <Run Text="GSTIN " /><Run Text="{Binding CompanyGstin, Mode=OneWay}" /><Run Text=" · State " /><Run Text="{Binding CompanyStateCode, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding PartyName}" Style="{StaticResource Text.Body}" Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Text.Caption}">
              <Run Text="GSTIN " /><Run Text="{Binding PartyGstin, Mode=OneWay}" /><Run Text=" · Place of supply " /><Run Text="{Binding PlaceOfSupplyName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Caption}" Visibility="{Binding OriginalNumber, Converter={StaticResource VisibleWhen}}">
              <Run Text="Against " /><Run Text="{Binding OriginalNumber, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Caption}" Visibility="{Binding Reference, Converter={StaticResource VisibleWhen}}">
              <Run Text="Reference " /><Run Text="{Binding Reference, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Caption}" Visibility="{Binding CancellationReason, Converter={StaticResource VisibleWhen}}" TextWrapping="Wrap">
              <Run Text="Cancelled: " /><Run Text="{Binding CancellationReason, Mode=OneWay}" />
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,12,0,0" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                      <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                        <Run Text="{Binding Quantity, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Rate, Mode=OneWay}" />
                        <Run Text=" · HSN " /><Run Text="{Binding HsnCode, Mode=OneWay}" /><Run Text=" · GST " /><Run Text="{Binding TaxRatePercent, Mode=OneWay}" /><Run Text="%" />
                        <Run Text=" · less " /><Run Text="{Binding Discount, Mode=OneWay}" />
                        <Run Text="{Binding SerialNumber, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Batch, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Taxable, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="120" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Taxable value" Style="{StaticResource Text.Secondary}" />
              <TextBlock Grid.Column="1" Text="{Binding Taxable, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
              <TextBlock Grid.Row="1" Text="CGST" Style="{StaticResource Text.Secondary}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Cgst, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
              <TextBlock Grid.Row="2" Text="SGST" Style="{StaticResource Text.Secondary}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Sgst, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
              <TextBlock Grid.Row="3" Text="IGST" Style="{StaticResource Text.Secondary}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Igst, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
              <TextBlock Grid.Row="4" Text="Round off" Style="{StaticResource Text.Secondary}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RoundOff, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
              <TextBlock Grid.Row="5" Text="Total" Style="{StaticResource Text.Section}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Total, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
              <TextBlock Grid.Row="6" Text="Outstanding" Style="{StaticResource Text.Secondary}" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Outstanding, Converter={StaticResource Amount}, ConverterParameter=blank}" Style="{StaticResource Text.Amount}" />
              <TextBlock Grid.Row="7" Text="Cost of goods" Style="{StaticResource Text.Secondary}" Visibility="{Binding CostOfGoods, Converter={StaticResource VisibleWhen}}" />
              <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CostOfGoods, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" Visibility="{Binding CostOfGoods, Converter={StaticResource VisibleWhen}}" />
            </Grid>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"><Run Text="Invoice date: " /><Run Text="{Binding SupplierInvoiceDate, StringFormat=dd-MM-yyyy, Mode=OneWay}" /><Run Text="   Received: " /><Run Text="{Binding ReceivedDate, StringFormat=dd-MM-yyyy, Mode=OneWay}" /></TextBlock>
            <TextBlock Style="{StaticResource Text.Caption}"><Run Text="PO: " /><Run Text="{Binding PurchaseOrderNumber, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding PurchaseOrderYear, Mode=OneWay}" /></TextBlock>
            <TextBlock Text="Allocations" Style="{StaticResource Text.Label}" Margin="0,12,0,4" Visibility="{Binding Allocations.Count, Converter={StaticResource VisibleWhen}}" />
            <ItemsControl ItemsSource="{Binding Allocations}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Caption}">
                      <Run Text="{Binding OtherType, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding OtherNumber, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Amount, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid>
      <!-- Invoices or bills -->
      <DockPanel Visibility="{Binding ShowDocuments, Converter={StaticResource VisibleWhen}}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock Text="Status" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="130" AutomationProperties.Name="Status filter" />
        </StackPanel>
        <controls:QikDataGrid LayoutKey="billing-documents" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" SelectionMode="Single" AutomationProperties.Name="Documents">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy}" SortMemberPath="Date" Width="90" />
            <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="140" />
            <DataGridTextColumn Header="Party" Binding="{Binding PartyName}" Width="*" MinWidth="140" />
            <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="100" />
            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="64" />
            <DataGridTextColumn Header="Taxable" Binding="{Binding Taxable, Converter={StaticResource Amount}}" SortMemberPath="Taxable" Width="110" controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
            <DataGridTextColumn Header="Tax" Binding="{Binding Tax, Converter={StaticResource Amount}}" SortMemberPath="Tax" Width="100" controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
            <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource Amount}}" SortMemberPath="Total" Width="110" controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
            <DataGridTextColumn Header="Outstanding" Binding="{Binding Outstanding, Converter={StaticResource Amount}, ConverterParameter=blank}" SortMemberPath="Outstanding" Width="110" controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
            <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="100" />
          </DataGrid.Columns>
        </controls:QikDataGrid>
      </DockPanel>
      <!-- Credit or debit notes -->
      <DockPanel Visibility="{Binding ShowReturns, Converter={StaticResource VisibleWhen}}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock Text="Status" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="130" AutomationProperties.Name="Status filter" />
          <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" Text="Returns are made from an invoice or bill: select it under the first section and choose Return goods." />
        </StackPanel>
        <controls:QikDataGrid LayoutKey="billing-returns" ItemsSource="{Binding Returns}" SelectedItem="{Binding SelectedDocument}" SelectionMode="Single" AutomationProperties.Name="Returns">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy}" SortMemberPath="Date" Width="90" />
            <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="140" />
            <DataGridTextColumn Header="Against" Binding="{Binding OriginalNumber}" Width="140" />
            <DataGridTextColumn Header="Party" Binding="{Binding PartyName}" Width="*" MinWidth="140" />
            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="64" />
            <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource Amount}}" SortMemberPath="Total" Width="110" controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
            <DataGridTextColumn Header="Unapplied" Binding="{Binding Outstanding, Converter={StaticResource Amount}, ConverterParameter=blank}" SortMemberPath="Outstanding" Width="110" controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
            <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="110" />
          </DataGrid.Columns>
        </controls:QikDataGrid>
      </DockPanel>
      <!-- Editor: a short everyday path; optional details expand in place. -->
      <Border Style="{StaticResource Panel}" Visibility="{Binding ShowEditor, Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding CanCreate}">
        <DockPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
            <StackPanel>
              <WrapPanel Visibility="{Binding DraftTotals, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,16,0"><Run Text="Taxable: " /><Run Text="{Binding DraftTotals.Taxable, Converter={StaticResource Amount}, Mode=OneWay}" /></TextBlock>
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,16,0"><Run Text="GST: " /><Run Text="{Binding DraftTotals.Tax, Converter={StaticResource Amount}, Mode=OneWay}" /></TextBlock>
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,16,0"><Run Text="Round off: " /><Run Text="{Binding DraftTotals.RoundOff, Converter={StaticResource Amount}, Mode=OneWay}" /></TextBlock>
                <TextBlock Style="{StaticResource Text.Section}"><Run Text="Total: " /><Run Text="{Binding DraftTotals.Total, Converter={StaticResource Amount}, Mode=OneWay}" /></TextBlock>
              </WrapPanel>
              <WrapPanel>
                <Button Content="Save draft / calculate" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" />
                <Button Content="{Binding SaveLabel}" Command="{Binding SaveAndPostCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0" />
                <Button Content="Start new" Command="{Binding StartNewCommand}" Style="{StaticResource Button.Subtle}" />
              </WrapPanel>
              <TextBlock Text="Drafts can be edited. Saving the final bill updates stock and accounts together. Totals shown are from the last saved draft." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <WrapPanel>
                <StackPanel Width="300" Margin="0,0,12,10" IsEnabled="{Binding CanEditHeader}">
                  <TextBlock Text="{Binding PartyLabel}" Style="{StaticResource Text.Label}" />
                  <controls:SearchComboBox Choices="{Binding Parties}" SelectedItem="{Binding Party}" DisplayMemberPath="LookupLabel" AutomationProperties.Name="Search supplier or customer by number or name" />
                </StackPanel>
                <StackPanel Width="140" Margin="0,0,12,10">
                  <TextBlock Text="Bill date (dd-mm-yyyy)" Style="{StaticResource Text.Label}" />
                  <TextBox Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bill date (dd-mm-yyyy)" MaxLength="10" />
                </StackPanel>
                <StackPanel Width="200" Margin="0,0,12,10">
                  <TextBlock Text="Invoice number / reference" Style="{StaticResource Text.Label}" />
                  <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Invoice number / reference" MaxLength="40" />
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,12,10">
                  <TextBlock Text="Godown / warehouse" Style="{StaticResource Text.Label}" />
                  <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name" AutomationProperties.Name="Godown or warehouse" />
                </StackPanel>
              </WrapPanel>
              <WrapPanel Visibility="{Binding IsPurchase, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,8">
                <TextBlock Text="New supplier? Add it on the Add Supplier page before starting this bill." Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Add Supplier" Command="{Binding OpenAddSupplierCommand}" Margin="0,0,8,0" />
                <Button Content="Supplier accounts" Command="{Binding OpenSupplierAccountsCommand}" />
              </WrapPanel>
              <TextBlock Text="{Binding Party.Address}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,8"><Run Text="{Binding Party.Phone, Mode=OneWay}" /><Run Text="   GSTIN: " /><Run Text="{Binding Party.Gstin, Mode=OneWay}" /><Run Text="   Balance: " /><Run Text="{Binding Party.LedgerBalance, Converter={StaticResource Amount}, Mode=OneWay}" /></TextBlock>
              <Expander Header="Supplier invoice and order details" Margin="0,0,0,8" Visibility="{Binding IsPurchase, Converter={StaticResource VisibleWhen}}">
                <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding CanEditHeader}">
                  <StackPanel Width="170" Margin="0,0,12,10">
                    <TextBlock Text="Invoice date (dd-mm-yyyy)" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding SupplierInvoiceDate, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Invoice date (dd-mm-yyyy)" />
                  </StackPanel>
                  <StackPanel Width="170" Margin="0,0,12,10">
                    <TextBlock Text="Received date (dd-mm-yyyy)" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding ReceivedDate, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Received date (dd-mm-yyyy)" />
                  </StackPanel>
                  <StackPanel Width="170" Margin="0,0,12,10">
                    <TextBlock Text="PO number" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding PurchaseOrderNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="PO number" />
                  </StackPanel>
                  <StackPanel Width="170" Margin="0,0,12,10">
                    <TextBlock Text="PO year" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding PurchaseOrderYear, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" AutomationProperties.Name="PO year" />
                  </StackPanel>
                </WrapPanel>
              </Expander>
              <Expander Header="Payment and more details" Margin="0,0,0,12">
                <WrapPanel Margin="0,8,0,0">
                  <StackPanel Width="130" Margin="0,0,12,10" IsEnabled="{Binding CanEditHeader}">
                    <TextBlock Text="Payment" Style="{StaticResource Text.Label}" />
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="Cash or credit" />
                  </StackPanel>
                  <StackPanel Width="180" Margin="0,0,12,10" Visibility="{Binding IsCash, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="Paid from" Style="{StaticResource Text.Label}" />
                    <ComboBox ItemsSource="{Binding CashAccounts}" SelectedItem="{Binding CashAccount}" DisplayMemberPath="Name" AutomationProperties.Name="Cash or bank account" />
                  </StackPanel>
                  <StackPanel Width="180" Margin="0,0,12,10" Visibility="{Binding ShowWalkIn, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="Walk-in customer" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding WalkInName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Walk-in name" />
                  </StackPanel>
                  <StackPanel Width="300" Margin="0,0,12,10">
                    <TextBlock Text="Remarks" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Remarks" MaxLength="300" />
                  </StackPanel>
                  <StackPanel Margin="0,16,12,8" IsEnabled="{Binding CanEditHeader}">
                    <CheckBox Content="Rates include GST" IsChecked="{Binding PricesIncludeTax}" />
                    <CheckBox Content="Round total to rupees" IsChecked="{Binding RoundToRupee}" />
                  </StackPanel>
                </WrapPanel>
              </Expander>
              <TextBlock Text="Items" Style="{StaticResource Text.Section}" Margin="0,4,0,8" />
              <DockPanel Margin="0,0,0,12" Visibility="{Binding CanEditHeader, Converter={StaticResource VisibleWhen}}">
                <TextBlock DockPanel.Dock="Left" Text="Scan code + Enter" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Text="{Binding CodeEntry, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Scan or enter item code">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddByCodeCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="40" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Item code / name" Style="{StaticResource Text.Label}" />
                            <controls:SearchComboBox Choices="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Product}" Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="LookupLabel" IsEnabled="{Binding IsReturnLine, Converter={StaticResource Inverse}}" AutomationProperties.Name="Search item by code or name" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Quantity" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Quantity" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Unit / pack" Style="{StaticResource Text.Label}" />
                            <ComboBox ItemsSource="{Binding DataContext.Units, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Unit}" DisplayMemberPath="Code" IsEnabled="{Binding IsReturnLine, Converter={StaticResource Inverse}}" AutomationProperties.Name="Unit blank means base unit" />
                          </StackPanel>
                          <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Text="Rate" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" IsEnabled="{Binding IsReturnLine, Converter={StaticResource Inverse}}" AutomationProperties.Name="Rate blank means saved price" />
                          </StackPanel>
                          <Button Grid.Column="4" Content="" Style="{StaticResource Button.Icon}" VerticalAlignment="Bottom" ToolTip="Remove item" AutomationProperties.Name="Remove item" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"><Run Text="Unit: " /><Run Text="{Binding Product.UnitCode, Mode=OneWay}" /><Run Text="   GST: " /><Run Text="{Binding Product.TaxCategoryName, Mode=OneWay}" /><Run Text="   HSN: " /><Run Text="{Binding Product.HsnCode, Mode=OneWay}" /><Run Text="   MRP: " /><Run Text="{Binding Product.Mrp, Converter={StaticResource Amount}, Mode=OneWay}" /></TextBlock>
                        <Expander Header="Discount, batch, expiry and serial" Margin="0,4,0,0" IsEnabled="{Binding IsReturnLine, Converter={StaticResource Inverse}}">
                          <WrapPanel Margin="0,8,0,0">
                            <StackPanel Width="100" Margin="0,0,12,10">
                              <TextBlock Text="Discount %" Style="{StaticResource Text.Label}" />
                              <TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Discount %" />
                            </StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,10">
                              <TextBlock Text="Discount amount" Style="{StaticResource Text.Label}" />
                              <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Discount amount" />
                            </StackPanel>
                            <StackPanel Width="140" Margin="0,0,12,10">
                              <TextBlock Text="Batch" Style="{StaticResource Text.Label}" />
                              <TextBox Text="{Binding Batch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Batch" MaxLength="40" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,10">
                              <TextBlock Text="Expiry (dd-mm-yyyy)" Style="{StaticResource Text.Label}" />
                              <TextBox Text="{Binding Expires, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Expiry (dd-mm-yyyy)" MaxLength="10" />
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,10">
                              <TextBlock Text="Serial number" Style="{StaticResource Text.Label}" />
                              <TextBox Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Serial number" MaxLength="60" />
                            </StackPanel>
                          </WrapPanel>
                        </Expander>
                        <TextBlock Text="{Binding ReturnDescription}" Style="{StaticResource Text.Caption}" Visibility="{Binding IsReturnLine, Converter={StaticResource VisibleWhen}}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Add another item" Command="{Binding AddLineCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding CanEditHeader, Converter={StaticResource VisibleWhen}}" />
              <Expander Header="Add a new item to the list" IsExpanded="{Binding ShowNewItem}" Visibility="{Binding CanAddItem, Converter={StaticResource VisibleWhen}}" Margin="0,8,0,12">
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="Enter a new code and name. An existing code selects the saved item without changing it." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                  <WrapPanel>
                    <StackPanel Width="140" Margin="0,0,12,10">
                      <TextBlock Text="Item code" Style="{StaticResource Text.Label}" />
                      <TextBox Text="{Binding NewItemCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Item code" MaxLength="40" />
                    </StackPanel>
                    <StackPanel Width="240" Margin="0,0,12,10">
                      <TextBlock Text="Item name" Style="{StaticResource Text.Label}" />
                      <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Item name" MaxLength="120" />
                    </StackPanel>
                    <StackPanel Width="100" Margin="0,0,12,10">
                      <TextBlock Text="Unit" Style="{StaticResource Text.Label}" />
                      <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding NewItemUnit}" DisplayMemberPath="Code" AutomationProperties.Name="New item unit" />
                    </StackPanel>
                    <StackPanel Width="170" Margin="0,0,12,10">
                      <TextBlock Text="GST category (blank = no tax)" Style="{StaticResource Text.Label}" />
                      <ComboBox ItemsSource="{Binding TaxCategories}" SelectedItem="{Binding NewItemTax}" DisplayMemberPath="Name" AutomationProperties.Name="New item GST category" />
                    </StackPanel>
                    <StackPanel Width="120" Margin="0,0,12,10">
                      <TextBlock Text="Purchase rate" Style="{StaticResource Text.Label}" />
                      <TextBox Text="{Binding NewItemRate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Purchase rate" />
                    </StackPanel>
                    <StackPanel Width="120" Margin="0,0,12,10">
                      <TextBlock Text="Selling price" Style="{StaticResource Text.Label}" />
                      <TextBox Text="{Binding NewItemSellingPrice, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Selling price" />
                    </StackPanel>
                    <StackPanel Width="100" Margin="0,0,12,10">
                      <TextBlock Text="MRP" Style="{StaticResource Text.Label}" />
                      <TextBox Text="{Binding NewItemMrp, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="MRP" />
                    </StackPanel>
                    <StackPanel Width="100" Margin="0,0,12,10">
                      <TextBlock Text="HSN code" Style="{StaticResource Text.Label}" />
                      <TextBox Text="{Binding NewItemHsn, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="HSN code" MaxLength="8" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,12,10">
                      <TextBlock Text="Tracking" Style="{StaticResource Text.Label}" />
                      <ComboBox ItemsSource="{Binding TrackingModes}" SelectedItem="{Binding NewItemTracking}" AutomationProperties.Name="New item tracking" />
                    </StackPanel>
                    <CheckBox Content="Track expiry" IsChecked="{Binding NewItemTracksExpiry}" Margin="0,18,12,10" />
                    <Button Content="Add item and use it" Command="{Binding AddNewItemCommand}" VerticalAlignment="Center" />
                  </WrapPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <!-- Receipts or payments -->
      <Grid Visibility="{Binding ShowSettlements, Converter={StaticResource VisibleWhen}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="460" />
        </Grid.ColumnDefinitions>
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Preview" Command="{Binding PreviewSettlementCommand}" Margin="0,0,8,0" />
            <Button Content="Print" Command="{Binding PrintSettlementCommand}" Margin="0,0,8,0" />
            <Button Content="Export PDF" Command="{Binding ExportSettlementPdfCommand}" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding CanCancel, Converter={StaticResource VisibleWhen}}">
            <TextBox Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}" Width="220" MaxLength="300" Margin="0,0,8,0" AutomationProperties.Name="Reason for reversing" />
            <TextBox Text="{Binding ActionDate, UpdateSourceTrigger=PropertyChanged}" Width="100" MaxLength="10" Margin="0,0,8,0" AutomationProperties.Name="Reversal date (dd-mm-yyyy)" />
            <Button Content="Reverse selected" Style="{StaticResource Button.Danger}" Command="{Binding ReverseSettlementCommand}" />
          </StackPanel>
          <controls:QikDataGrid LayoutKey="billing-settlements" ItemsSource="{Binding SettlementRows}" SelectedItem="{Binding SelectedSettlement}" SelectionMode="Single" AutomationProperties.Name="Receipts and payments">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy}" SortMemberPath="Date" Width="90" />
              <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="130" />
              <DataGridTextColumn Header="Type" Binding="{Binding KindLabel}" Width="130" />
              <DataGridTextColumn Header="Party" Binding="{Binding PartyName}" Width="*" MinWidth="120" />
              <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="110" />
              <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="90" />
              <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="110" />
              <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource Amount}}" SortMemberPath="Amount" Width="110" controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
              <DataGridTextColumn Header="Unapplied" Binding="{Binding Unapplied, Converter={StaticResource Amount}, ConverterParameter=blank}" SortMemberPath="Unapplied" Width="100" controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
              <DataGridTemplateColumn Header="Status" Width="90" SortMemberPath="IsReversed">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Badge.Warning}" Visibility="{Binding IsReversed, Converter={StaticResource VisibleWhen}}">
                      <TextBlock Text="Reversed" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </controls:QikDataGrid>
        </DockPanel>
        <Border Grid.Column="2" Style="{StaticResource Panel}" IsEnabled="{Binding CanCreate}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="New receipt, payment or refund" Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
            <Grid DockPanel.Dock="Top">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Type" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding SettlementKinds}" SelectedItem="{Binding SettlementKind}" AutomationProperties.Name="Settlement type" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding PartyLabel}" Style="{StaticResource Text.Label}" />
                <controls:SearchComboBox Choices="{Binding Parties}" SelectedItem="{Binding SettlementParty}" DisplayMemberPath="LookupLabel" AutomationProperties.Name="Supplier or customer" />
              </StackPanel>
              <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock Text="Cash or bank account" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding CashAccounts}" SelectedItem="{Binding SettlementAccount}" DisplayMemberPath="Name" AutomationProperties.Name="Cash or bank account" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                <TextBlock Text="Method" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SettlementMethod}" AutomationProperties.Name="Payment method" />
              </StackPanel>
              <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="Amount" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding SettlementAmount, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Amount" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                <TextBlock Text="Date" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding SettlementDate, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Date (dd-mm-yyyy)" />
              </StackPanel>
            </Grid>
            <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
              <TextBlock Text="Reference (cheque, UPI or bank reference)" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding SettlementReference, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="Reference" />
              <TextBlock Text="Narration" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
              <TextBox Text="{Binding SettlementNarration, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Narration" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <TextBlock Style="{StaticResource Text.Caption}">
                <Run Text="Allocated: " /><Run Text="{Binding AllocationTotal, Mode=OneWay}" /><Run Text=" (the rest stays as an advance)" />
              </TextBlock>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Allocate oldest first" Command="{Binding AllocateOldestFirstCommand}" Margin="0,0,8,0" />
                <Button Content="Post" Style="{StaticResource Button.Primary}" Command="{Binding PostSettlementCommand}" />
              </StackPanel>
            </StackPanel>
            <DockPanel Margin="0,12,0,0">
              <TextBlock DockPanel.Dock="Top" Text="Open documents (enter the amount to apply)" Style="{StaticResource Text.Label}" />
              <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl ItemsSource="{Binding OpenItems}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="100" />
                          <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Item.Number}" Style="{StaticResource Text.Body}" />
                          <TextBlock Style="{StaticResource Text.Caption}">
                            <Run Text="{Binding Item.Type, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Item.Date, StringFormat=dd-MM-yyyy, Mode=OneWay}" />
                          </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Item.Open, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" Margin="0,0,8,0" ToolTip="Open" />
                        <TextBox Grid.Column="2" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Amount to apply" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
