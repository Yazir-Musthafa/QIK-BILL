<UserControl x:Class="Nexora.Desktop.Views.Crm.CrmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nexora.Desktop.Controls">
  <UserControl.Resources>
    <DataTemplate x:Key="TimelineItem">
      <StackPanel Margin="0,0,0,8">
        <TextBlock Style="{StaticResource Text.Caption}">
          <Run Text="{Binding WhenUtc, StringFormat=dd-MM-yyyy HH:mm, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding By, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel Margin="24,20,24,24">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" />
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
    </DockPanel>
    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Sections}" SelectedItem="{Binding Section}" DisplayMemberPath="Label" Margin="0,0,0,16"
             AutomationProperties.Name="CRM sections">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />

    <Grid>
      <!-- Leads and prospects -->
      <Grid Visibility="{Binding ShowLeads, Converter={StaticResource VisibleWhen}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Content="New lead" Style="{StaticResource Button.Primary}" Command="{Binding NewLeadCommand}" Margin="0,0,12,4" IsEnabled="{Binding CanManage}" />
            <CheckBox Content="Show won and lost" IsChecked="{Binding ShowClosedLeads}" VerticalAlignment="Center" Margin="0,0,0,4" />
          </WrapPanel>
          <controls:QikDataGrid LayoutKey="crm.leads" ItemsSource="{Binding Leads}" SelectedItem="{Binding SelectedLead}" SelectionMode="Single" AutomationProperties.Name="Leads">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" />
              <DataGridTextColumn Header="Organisation" Binding="{Binding Organisation}" Width="140" />
              <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110" />
              <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
              <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="110" />
              <DataGridTextColumn Header="Open follow-ups" Binding="{Binding OpenFollowUps}" Width="110" />
              <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="130" />
            </DataGrid.Columns>
          </controls:QikDataGrid>
        </DockPanel>

        <Border Grid.Column="2" Style="{StaticResource Panel}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
              <TextBlock Text="Lead" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
              <StackPanel IsEnabled="{Binding CanManage}">
                <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding LeadName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,0,0,8" AutomationProperties.Name="Lead name" />
                <TextBlock Text="Organisation" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding LeadOrganisation, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,0,0,8" AutomationProperties.Name="Organisation" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Phone" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding LeadPhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" AutomationProperties.Name="Lead phone" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Email" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding LeadEmail, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Lead email" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Source" Style="{StaticResource Text.Label}" />
                    <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding LeadSource}" AutomationProperties.Name="Lead source" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Owner" Style="{StaticResource Text.Label}" />
                    <ComboBox ItemsSource="{Binding Members}" SelectedItem="{Binding LeadOwner}" DisplayMemberPath="Name" AutomationProperties.Name="Lead owner" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Notes" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding LeadNotes, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,8"
                         AutomationProperties.Name="Lead notes" />
                <Button Content="Save lead" Style="{StaticResource Button.Primary}" Command="{Binding SaveLeadCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />

                <TextBlock Text="Status" Style="{StaticResource Text.Label}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <ComboBox ItemsSource="{Binding OpenStatuses}" SelectedItem="{Binding LeadStatus}" Width="160" Margin="0,0,8,0" AutomationProperties.Name="Lead status" />
                  <Button Content="Set status" Command="{Binding SetLeadStatusCommand}" />
                </StackPanel>
                <TextBlock Text="Reason lost" Style="{StaticResource Text.Label}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <TextBox Text="{Binding LostReason, UpdateSourceTrigger=PropertyChanged}" Width="220" MaxLength="300" Margin="0,0,8,0" AutomationProperties.Name="Reason lost" />
                  <Button Content="Mark lost" Style="{StaticResource Button.Danger}" Command="{Binding MarkLostCommand}" />
                </StackPanel>

                <Button Content="Convert to customer" Command="{Binding ConvertCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                <StackPanel Visibility="{Binding HasDuplicates, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,12">
                  <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="These customers look the same. Link the lead to one of them instead of creating a duplicate." />
                  <ComboBox ItemsSource="{Binding DuplicateCandidates}" SelectedItem="{Binding DuplicateChoice}" DisplayMemberPath="Name" Margin="0,4,0,4"
                            AutomationProperties.Name="Matching customers" />
                  <Button Content="Link to this customer" Command="{Binding LinkToCustomerCommand}" HorizontalAlignment="Left" />
                </StackPanel>

                <TextBlock Text="Call note or activity" Style="{StaticResource Text.Label}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <ComboBox ItemsSource="{Binding ActivityKinds}" SelectedItem="{Binding ActivityKind}" Width="110" Margin="0,0,8,0" AutomationProperties.Name="Activity kind" />
                  <Button Content="Record" Command="{Binding AddActivityCommand}" />
                </StackPanel>
                <TextBox Text="{Binding ActivitySummary, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" Margin="0,0,0,12"
                         AutomationProperties.Name="Activity summary" />
              </StackPanel>
              <TextBlock Text="Timeline" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Timeline}" ItemTemplate="{StaticResource TimelineItem}" Focusable="False" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- Follow-ups -->
      <Grid Visibility="{Binding ShowFollowUps, Converter={StaticResource VisibleWhen}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Content="New follow-up" Style="{StaticResource Button.Primary}" Command="{Binding NewFollowUpCommand}" Margin="0,0,12,4" IsEnabled="{Binding CanManage}" />
            <CheckBox Content="Mine only" IsChecked="{Binding MineOnly}" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox Content="Include done" IsChecked="{Binding IncludeDone}" VerticalAlignment="Center" Margin="0,0,0,4" />
          </WrapPanel>
          <controls:QikDataGrid LayoutKey="crm.followups" ItemsSource="{Binding FollowUps}" SelectedItem="{Binding SelectedFollowUp}" SelectionMode="Single" AutomationProperties.Name="Follow-ups">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=dd-MM-yyyy}" SortMemberPath="DueDate" Width="90" />
              <DataGridTextColumn Header="Task" Binding="{Binding Title}" Width="*" MinWidth="160" />
              <DataGridTextColumn Header="Regarding" Binding="{Binding Regarding}" Width="160" />
              <DataGridTextColumn Header="Assignee" Binding="{Binding Assignee}" Width="120" />
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
            </DataGrid.Columns>
          </controls:QikDataGrid>
        </DockPanel>
        <Border Grid.Column="2" Style="{StaticResource Panel}" IsEnabled="{Binding CanManage}">
          <StackPanel>
            <TextBlock Text="Follow-up" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
            <TextBlock Text="Task" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding FollowUpTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,8" AutomationProperties.Name="Follow-up task" />
            <TextBlock Text="Due date" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding FollowUpDue, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Width="110" HorizontalAlignment="Left" Margin="0,0,0,8"
                     AutomationProperties.Name="Due date (dd-mm-yyyy)" />
            <TextBlock Text="Assignee" Style="{StaticResource Text.Label}" />
            <ComboBox ItemsSource="{Binding Members}" SelectedItem="{Binding FollowUpAssignee}" DisplayMemberPath="Name" Margin="0,0,0,8" AutomationProperties.Name="Assignee" />
            <TextBlock Text="Customer" Style="{StaticResource Text.Label}" />
            <ComboBox ItemsSource="{Binding CustomerChoices}" SelectedItem="{Binding FollowUpCustomer}" DisplayMemberPath="Name" Margin="0,0,0,8" AutomationProperties.Name="Customer" />
            <TextBlock Text="Notes" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding FollowUpNotes, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,8"
                     AutomationProperties.Name="Follow-up notes" />
            <WrapPanel>
              <Button Content="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveFollowUpCommand}" Margin="0,0,8,4" />
              <Button Content="Mark done or reopen" Command="{Binding ToggleDoneCommand}" Margin="0,0,8,4" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Enquiries -->
      <Grid Visibility="{Binding ShowEnquiries, Converter={StaticResource VisibleWhen}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <DockPanel>
          <Button DockPanel.Dock="Top" Content="New enquiry" Style="{StaticResource Button.Primary}" Command="{Binding NewEnquiryCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"
                  IsEnabled="{Binding CanManage}" />
          <controls:QikDataGrid LayoutKey="crm.enquiries" ItemsSource="{Binding Enquiries}" SelectedItem="{Binding SelectedEnquiry}" SelectionMode="Single" AutomationProperties.Name="Enquiries">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy}" SortMemberPath="Date" Width="90" />
              <DataGridTextColumn Header="From" Binding="{Binding For}" Width="150" />
              <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*" MinWidth="160" />
              <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="140" />
              <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="90" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
            </DataGrid.Columns>
          </controls:QikDataGrid>
        </DockPanel>
        <Border Grid.Column="2" Style="{StaticResource Panel}" IsEnabled="{Binding CanManage}">
          <StackPanel>
            <TextBlock Text="Enquiry" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
            <TextBlock Text="Date" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding EnquiryDate, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Width="110" HorizontalAlignment="Left" Margin="0,0,0,8"
                     AutomationProperties.Name="Enquiry date (dd-mm-yyyy)" />
            <TextBlock Text="Customer" Style="{StaticResource Text.Label}" />
            <ComboBox ItemsSource="{Binding CustomerChoices}" SelectedItem="{Binding EnquiryCustomer}" DisplayMemberPath="Name" Margin="0,0,0,8" AutomationProperties.Name="Enquiry customer" />
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" Text="For a lead, add the enquiry while the lead is selected, or keep the lead an existing enquiry already has." />
            <TextBlock Text="Subject" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding EnquirySubject, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,8" AutomationProperties.Name="Enquiry subject" />
            <TextBlock Text="Details" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding EnquiryDetails, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,8"
                     AutomationProperties.Name="Enquiry details" />
            <TextBlock Text="Product" Style="{StaticResource Text.Label}" />
            <ComboBox ItemsSource="{Binding ProductChoices}" SelectedItem="{Binding EnquiryProduct}" DisplayMemberPath="Name" Margin="0,0,0,8" AutomationProperties.Name="Enquiry product" />
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Channel" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding ActivityKinds}" SelectedItem="{Binding EnquiryChannel}" AutomationProperties.Name="Enquiry channel" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Status" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding EnquiryStatuses}" SelectedItem="{Binding EnquiryStatus}" AutomationProperties.Name="Enquiry status" />
              </StackPanel>
            </Grid>
            <Button Content="Save enquiry" Style="{StaticResource Button.Primary}" Command="{Binding SaveEnquiryCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Customer view -->
      <Grid Visibility="{Binding ShowCustomers, Converter={StaticResource VisibleWhen}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:QikDataGrid LayoutKey="crm.customers" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" SelectionMode="Single" AutomationProperties.Name="Customers">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="*" MinWidth="140" />
            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110" />
          </DataGrid.Columns>
        </controls:QikDataGrid>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding HasOverview, Converter={StaticResource VisibleWhen}}">
          <StackPanel>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{Binding Overview.Customer.Name}" Style="{StaticResource Text.Section}" />
                <TextBlock Style="{StaticResource Text.Caption}">
                  <Run Text="{Binding Overview.Customer.Phone, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Overview.Customer.Email, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Overview.Customer.City, Mode=OneWay}" />
                </TextBlock>
                <WrapPanel Margin="0,8,0,0" Visibility="{Binding Overview.CanSeeSales, Converter={StaticResource VisibleWhen}}">
                  <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Outstanding" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding Overview.Customer.Outstanding, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Ledger balance" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding Overview.Customer.LedgerBalance, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Credit limit" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding Overview.Customer.CreditLimit, Converter={StaticResource Amount}}" Style="{StaticResource Text.Amount}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Credit available" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding Overview.CreditAvailable, Converter={StaticResource Amount}, TargetNullValue=No limit}" Style="{StaticResource Text.Amount}" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding Overview.CanSeeSales, Converter={StaticResource VisibleWhen}}">
              <TextBlock Text="Purchase history" Style="{StaticResource Text.Section}" Margin="0,0,0,4" />
              <controls:QikDataGrid LayoutKey="crm.customer.invoices" ItemsSource="{Binding Overview.Invoices}" MaxHeight="240" Margin="0,0,0,12" AutomationProperties.Name="Purchase history">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy}" SortMemberPath="Date" Width="90" />
                  <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="130" />
                  <DataGridTextColumn Header="Type" Binding="{Binding KindLabel}" Width="*" />
                  <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource Amount}}" SortMemberPath="Total" Width="100"
                                      controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
                  <DataGridTextColumn Header="Outstanding" Binding="{Binding Outstanding, Converter={StaticResource Amount}}" SortMemberPath="Outstanding" Width="100"
                                      controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
                  <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="100" />
                </DataGrid.Columns>
              </controls:QikDataGrid>
              <TextBlock Text="Payment history" Style="{StaticResource Text.Section}" Margin="0,0,0,4" />
              <controls:QikDataGrid LayoutKey="crm.customer.payments" ItemsSource="{Binding Overview.Payments}" MaxHeight="200" Margin="0,0,0,12" AutomationProperties.Name="Payment history">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy}" SortMemberPath="Date" Width="90" />
                  <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="130" />
                  <DataGridTextColumn Header="Type" Binding="{Binding KindLabel}" Width="*" />
                  <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="90" />
                  <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource Amount}}" SortMemberPath="Amount" Width="100"
                                      controls:Table.Total="True" HeaderStyle="{StaticResource Header.Amount}" ElementStyle="{StaticResource Cell.Amount}" />
                </DataGrid.Columns>
              </controls:QikDataGrid>
            </StackPanel>

            <StackPanel Visibility="{Binding Overview.CanSeeService, Converter={StaticResource VisibleWhen}}">
              <TextBlock Text="Service history" Style="{StaticResource Text.Section}" Margin="0,0,0,4" />
              <controls:QikDataGrid LayoutKey="crm.customer.service" ItemsSource="{Binding Overview.ServiceJobs}" MaxHeight="200" Margin="0,0,0,12" AutomationProperties.Name="Service history">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Received" Binding="{Binding ReceivedOn, StringFormat=dd-MM-yyyy}" SortMemberPath="ReceivedOn" Width="90" />
                  <DataGridTextColumn Header="Job" Binding="{Binding Number}" Width="130" />
                  <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="*" />
                  <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="110" />
                  <DataGridTextColumn Header="Charge" Binding="{Binding Charge}" Width="90" />
                  <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="110" />
                </DataGrid.Columns>
              </controls:QikDataGrid>
            </StackPanel>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Panel}">
                <StackPanel>
                  <TextBlock Text="Contacts" Style="{StaticResource Text.Section}" Margin="0,0,0,4" />
                  <ListBox ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}" MaxHeight="140" AutomationProperties.Name="Contacts">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource Text.Body}">
                          <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Role, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Phone, Mode=OneWay}" />
                        </TextBlock>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel IsEnabled="{Binding CanManage}" Margin="0,8,0,0">
                    <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,0,0,4" AutomationProperties.Name="Contact name" />
                    <TextBox Text="{Binding ContactRole, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,0,0,4" AutomationProperties.Name="Contact role" />
                    <TextBox Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,0,0,4" AutomationProperties.Name="Contact phone" />
                    <TextBox Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,0,0,4" AutomationProperties.Name="Contact email" />
                    <CheckBox Content="Primary contact" IsChecked="{Binding ContactPrimary}" Margin="0,0,0,4" />
                    <WrapPanel>
                      <Button Content="Save contact" Command="{Binding SaveContactCommand}" Margin="0,0,8,4" />
                      <Button Content="Remove" Style="{StaticResource Button.Danger}" Command="{Binding DeleteContactCommand}" Margin="0,0,8,4" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                  <TextBlock Text="Special prices" Style="{StaticResource Text.Section}" Margin="0,0,0,4" />
                  <ListBox ItemsSource="{Binding Prices}" SelectedItem="{Binding SelectedPrice}" MaxHeight="140" AutomationProperties.Name="Customer prices">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource Text.Body}">
                          <Run Text="{Binding Sku, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Price, Converter={StaticResource Amount}, Mode=OneWay}" /><Run Text=" (list " /><Run Text="{Binding SellingPrice, Converter={StaticResource Amount}, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel IsEnabled="{Binding CanSetPrices}" Margin="0,8,0,0">
                    <ComboBox ItemsSource="{Binding ProductChoices}" SelectedItem="{Binding PriceProduct}" DisplayMemberPath="Name" Margin="0,0,0,4" AutomationProperties.Name="Price product" />
                    <TextBox Text="{Binding PriceAmount, UpdateSourceTrigger=PropertyChanged}" MaxLength="14" Margin="0,0,0,4" AutomationProperties.Name="Price per base unit" />
                    <WrapPanel>
                      <Button Content="Save price" Command="{Binding SavePriceCommand}" Margin="0,0,8,4" />
                      <Button Content="Remove" Style="{StaticResource Button.Danger}" Command="{Binding RemovePriceCommand}" Margin="0,0,8,4" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="Communication history" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
                <StackPanel IsEnabled="{Binding CanManage}" Margin="0,0,0,12">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ComboBox ItemsSource="{Binding ActivityKinds}" SelectedItem="{Binding ActivityKind}" Width="110" Margin="0,0,8,0" AutomationProperties.Name="Activity kind" />
                    <Button Content="Record" Command="{Binding AddActivityCommand}" />
                  </StackPanel>
                  <TextBox Text="{Binding ActivitySummary, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                           AutomationProperties.Name="Call note" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Timeline}" ItemTemplate="{StaticResource TimelineItem}" Focusable="False" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
