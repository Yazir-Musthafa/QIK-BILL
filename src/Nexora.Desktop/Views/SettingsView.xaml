<UserControl x:Class="Nexora.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nexora.Desktop.Controls">
  <DockPanel Margin="24,20,24,0">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />
    <!-- Section list: only sections the role may open are listed -->
    <ListBox DockPanel.Dock="Left" Width="220" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
             AutomationProperties.Name="Settings sections" VerticalAlignment="Top" Margin="0,0,24,0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.Icon}" FontSize="{StaticResource IconSizeSmall}" Text="{Binding Glyph}" Width="20"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <controls:TransitionPresenter Content="{Binding Current}" Focusable="False" />
  </DockPanel>
</UserControl>
