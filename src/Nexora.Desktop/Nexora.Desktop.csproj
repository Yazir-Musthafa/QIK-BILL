<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <AssemblyMetadata Include="QikAdminPasswordHashBase64" Value="$(QikAdminPasswordHashBase64)" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>QIKSuite</AssemblyName>
    <RootNamespace>Nexora.Desktop</RootNamespace>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Nexora.Infrastructure/Nexora.Infrastructure.csproj" />
    <ProjectReference Include="../Nexora.Accounting/Nexora.Accounting.csproj" />
    <ProjectReference Include="../Nexora.Printing/Nexora.Printing.csproj" />
    <ProjectReference Include="../Nexora.Reporting/Nexora.Reporting.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <!-- Licence notices that must ship with the application (and the installer). -->
    <None Include="../../licenses/THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses/THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
