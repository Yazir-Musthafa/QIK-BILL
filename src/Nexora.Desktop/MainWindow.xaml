<Window x:Class="Nexora.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Nexora.Desktop.Controls"
        Title="QIK Suite"
        Width="1366" Height="800" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource FontSizeBody}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.InputBindings>
    <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}" />
    <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Key="L" Modifiers="Control+Shift" Command="{Binding ToggleThemeCommand}" />
    <KeyBinding Key="G" Modifiers="Control+Shift" Command="{Binding OpenGalleryCommand}" />
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding GoToDashboardCommand}" />
    <KeyBinding Key="F1" Command="{Binding OpenHelpCommand}" />
    <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
  </Window.InputBindings>

  <Grid>
    <controls:TransitionPresenter Content="{Binding Current}" Focusable="False" />

    <!-- Dialog layer: scrim plus a single dialog; focus is trapped inside while open -->
    <Grid Visibility="{Binding Dialogs.Active, Converter={StaticResource VisibleWhen}}">
      <Border Background="{DynamicResource ScrimBrush}" />
      <Border Style="{StaticResource Popup.Surface}" Width="440" Padding="24,20"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              DataContext="{Binding Dialogs.Active}" controls:Behaviors.AnimateIn="True"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              AutomationProperties.Name="{Binding Title}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,20" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Cancel takes focus first so Enter never confirms a destructive action by accident -->
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" controls:Behaviors.FocusOnVisible="True" />
            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Style="{StaticResource Button.Primary}"
                    Visibility="{Binding IsDestructive, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Style="{StaticResource Button.Danger}"
                    Visibility="{Binding IsDestructive, Converter={StaticResource VisibleWhen}}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Toast layer: bottom right, never takes focus -->
    <ItemsControl ItemsSource="{Binding Toasts.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,24,24" Focusable="False" Width="360">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Popup.Surface}" Margin="0,8,0,0" Padding="12,10" controls:Behaviors.AnimateIn="True"
                  AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Message}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" Height="20" Width="20"
                      FontSize="{StaticResource IconSizeSmall}" VerticalAlignment="Top" Margin="8,0,0,0"
                      AutomationProperties.Name="Dismiss" Focusable="False"
                      Command="{Binding DataContext.Toasts.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}" />
              <TextBlock DockPanel.Dock="Left" Width="16" Margin="0,0,10,0" VerticalAlignment="Top">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                    <Setter Property="Text" Value="&#xE946;" />
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}" Value="Success">
                        <Setter Property="Text" Value="&#xE73E;" />
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="Warning">
                        <Setter Property="Text" Value="&#xE7BA;" />
                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="Error">
                        <Setter Property="Text" Value="&#xEA39;" />
                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
